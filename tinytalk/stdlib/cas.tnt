# TinyTalk Content-Addressed Merkle CAS Module (cas.tnt)
# Phase 11D: Cryptographic Content-Addressed Storage & Merkle Trees (v4.3.0)

struct CasBlock:
    offset: int
    size: int
    chunk_hash: str

struct MerkleProofStep:
    sibling_hash: str
    is_left: bool

def cas_block_new(offset: int, size: int, chunk_hash: str) -> CasBlock:
    return CasBlock(offset, size, chunk_hash)

def cas_is_power_of_two(n: int) -> bool:
    if n <= 0:
        return False
    return (n & (n - 1)) == 0

# TinyTalk Content-Addressed Merkle CAS Module (cas.tnt)
# Phase 11D: Cryptographic Content-Addressed Storage & Merkle Trees (v4.3.0)

struct CasBlock:
    offset: i64
    size: i64
    chunk_hash: str

struct MerkleProofStep:
    sibling_hash: str
    is_left: bool

fn cas_block_new(offset: i64, size: i64, chunk_hash: str) -> CasBlock:
    return CasBlock(offset, size, chunk_hash)

fn cas_is_power_of_two(n: i64) -> bool:
    if n <= 0:
        return False
    return (n & (n - 1)) == 0

# TinyTalk Quantum Formal Verification Standard Library (quantum_verify.tnt)
# Unitary L2-Norm Preservation and Entanglement Concurrence Certification

struct QuantumVerifyResult:
    is_valid: bool
    concurrence: f64
    norm_error: f64

def check_concurrence_maximal(concurrence: f64) -> bool:
    diff = concurrence - 1.0
    if diff < 0.0:
        diff = 0.0 - diff
    if diff < 0.0001:
        return True
    return False

def make_quantum_verify_result(valid: bool, conc: f64, err: f64) -> QuantumVerifyResult:
    return QuantumVerifyResult(valid, conc, err)

# Black Mamba Standard Library: alloc.bmb
# Vector 4: High-Throughput Thread-Local Lock-Free Memory Allocator
# Inspired by Mimalloc, Jemalloc, and TCMalloc.
# 100% Zero-CPython-overhead across native Windows PE32+, Linux ELF64, macOS ARM64, and JIT.

# ==============================================================================
# 1. Low-Level Native Memory & Hardware Intrinsics
# ==============================================================================

def mem_alloc(size_bytes: i64) -> i64:
    return __bmb_mem_alloc(size_bytes)

def mem_free(ptr: i64) -> i64:
    return __bmb_mem_free(ptr)

def mem_read(ptr: i64, offset: i64) -> i64:
    return __bmb_mem_read(ptr, offset)

def mem_write(ptr: i64, offset: i64, val: i64) -> i64:
    return __bmb_mem_write(ptr, offset, val)

def thread_id() -> i64:
    return __bmb_thread_id()

def atomic_cas(ptr: i64, expected: i64, desired: i64) -> i64:
    return __bmb_atomic_cas(ptr, expected, desired)


# ==============================================================================
# 2. Size Classes and Slab Parameters
# ==============================================================================
# 9 Size Classes: 16B, 32B, 64B, 128B, 256B, 512B, 1024B, 2048B, 4096B.
# All allocations <= 4096 bytes are handled via lock-free thread-local bins.
# All allocations > 4096 bytes fall back directly to OS chunks via mem_alloc.

SLAB_PAGE_SIZE = 65536         # 64 KB slab page carved out of the OS heap
SLAB_PAGE_HEADER_SIZE = 64     # 64 bytes (8 words) reserved for slab metadata
MAX_THREAD_SLOTS = 64          # Maximum concurrent thread cache slots in global table
SLOT_SIZE_BYTES = 128          # 128 bytes (16 words = 2 cache lines) per thread slot
GLOBAL_HEADER_BYTES = 128      # 128 bytes global table metadata header

def size_to_class(size_bytes: i64) -> i64:
    if size_bytes <= 16:
        return 0
    if size_bytes <= 32:
        return 1
    if size_bytes <= 64:
        return 2
    if size_bytes <= 128:
        return 3
    if size_bytes <= 256:
        return 4
    if size_bytes <= 512:
        return 5
    if size_bytes <= 1024:
        return 6
    if size_bytes <= 2048:
        return 7
    return 8

def class_to_size(cls: i64) -> i64:
    if cls == 0:
        return 16
    if cls == 1:
        return 32
    if cls == 2:
        return 64
    if cls == 3:
        return 128
    if cls == 4:
        return 256
    if cls == 5:
        return 512
    if cls == 6:
        return 1024
    if cls == 7:
        return 2048
    return 4096


# ==============================================================================
# 3. Global Thread-Local Table Management
# ==============================================================================

def alloc_init() -> i64:
    let root: i64 = __bmb_alloc_root_get()
    if root != 0:
        return root
    
    # Allocate global table: 128B header + 64 * 128B thread slots = 8320 bytes
    let total_bytes: i64 = GLOBAL_HEADER_BYTES + MAX_THREAD_SLOTS * SLOT_SIZE_BYTES
    let ptr: i64 = __bmb_mem_alloc(total_bytes)
    if ptr == 0:
        return 0
    
    # Initialize header
    mem_write(ptr, 0, 0x424D4241)     # Magic: 'BMBA'
    mem_write(ptr, 1, 1)              # Version: 1
    mem_write(ptr, 2, MAX_THREAD_SLOTS)
    mem_write(ptr, 3, SLOT_SIZE_BYTES)
    
    __bmb_alloc_root_set(ptr)
    return ptr

def _get_thread_slot() -> i64:
    let root: i64 = __bmb_alloc_root_get()
    if root == 0:
        root = alloc_init()
    
    let tid: i64 = __bmb_thread_id()
    if tid <= 0:
        tid = 1
    
    # Fast hash: tid ^ (tid >> 3)
    let h: i64 = tid ^ (tid / 8)
    if h < 0:
        h = 0 - h
    let start_idx: i64 = h % MAX_THREAD_SLOTS
    let table_base: i64 = root + GLOBAL_HEADER_BYTES
    
    # Linear probe up to MAX_THREAD_SLOTS
    for i in 0..MAX_THREAD_SLOTS:
        let idx: i64 = (start_idx + i) % MAX_THREAD_SLOTS
        let slot_ptr: i64 = table_base + idx * SLOT_SIZE_BYTES
        let owner: i64 = mem_read(slot_ptr, 0)
        if owner == tid:
            return slot_ptr
        if owner == 0:
            let claimed: i64 = __bmb_atomic_cas(slot_ptr, 0, tid)
            if claimed == 0:
                return slot_ptr
            if mem_read(slot_ptr, 0) == tid:
                return slot_ptr
    
    # Fallback to slot 0 if all slots are occupied
    return table_base

def _refill_bin(slot_ptr: i64, cls: i64) -> i64:
    let blk_size: i64 = class_to_size(cls)
    let page: i64 = __bmb_mem_alloc(SLAB_PAGE_SIZE)
    if page == 0:
        return 0
    
    let old_page_head: i64 = mem_read(slot_ptr, 10)
    let usable_bytes: i64 = SLAB_PAGE_SIZE - SLAB_PAGE_HEADER_SIZE
    let num_blocks: i64 = usable_bytes / blk_size
    
    # Setup page header:
    # Word 0: next_page, Word 1: blk_size, Word 2: num_blocks, Word 3: cls
    mem_write(page, 0, old_page_head)
    mem_write(page, 1, blk_size)
    mem_write(page, 2, num_blocks)
    mem_write(page, 3, cls)
    
    # Update thread slot's page list and page counter
    mem_write(slot_ptr, 10, page)
    mem_write(slot_ptr, 15, mem_read(slot_ptr, 15) + 1)
    
    # Carve blocks and link free-list: word 0 of each block stores next block pointer
    let start: i64 = page + SLAB_PAGE_HEADER_SIZE
    let limit: i64 = num_blocks - 1
    for i in 0..limit:
        let curr: i64 = start + i * blk_size
        let next_blk: i64 = start + (i + 1) * blk_size
        mem_write(curr, 0, next_blk)
    let last: i64 = start + limit * blk_size
    mem_write(last, 0, 0)
    
    # Update bin head
    mem_write(slot_ptr, 1 + cls, start)
    return start


# ==============================================================================
# 4. Fast-Path Lock-Free Allocation & Deallocation
# ==============================================================================

def alloc_fast(size_bytes: i64) -> i64:
    # Lock-free sub-nanosecond thread-local allocation.
    if size_bytes <= 0:
        return 0
    if size_bytes > 4096:
        return __bmb_mem_alloc(size_bytes)
    
    let cls: i64 = size_to_class(size_bytes)
    let slot_ptr: i64 = _get_thread_slot()
    let head: i64 = mem_read(slot_ptr, 1 + cls)
    if head == 0:
        head = _refill_bin(slot_ptr, cls)
        if head == 0:
            return 0
    
    # Pop head from thread-local free-list
    let next_free: i64 = mem_read(head, 0)
    mem_write(slot_ptr, 1 + cls, next_free)
    
    # Update telemetry counters: alloc_count and bytes_allocated
    mem_write(slot_ptr, 11, mem_read(slot_ptr, 11) + 1)
    let blk_size: i64 = class_to_size(cls)
    mem_write(slot_ptr, 13, mem_read(slot_ptr, 13) + blk_size)
    
    return head

def free_fast(ptr: i64, size_bytes: i64) -> void:
    # Lock-free sub-nanosecond thread-local sized deallocation.
    if ptr == 0:
        return
    if size_bytes <= 0:
        return
    if size_bytes > 4096:
        __bmb_mem_free(ptr)
        return
    
    let cls: i64 = size_to_class(size_bytes)
    let slot_ptr: i64 = _get_thread_slot()
    let head: i64 = mem_read(slot_ptr, 1 + cls)
    
    # Push ptr onto thread-local free-list (L1 cache warm)
    mem_write(ptr, 0, head)
    mem_write(slot_ptr, 1 + cls, ptr)
    
    # Update telemetry counters: free_count and bytes_freed
    mem_write(slot_ptr, 12, mem_read(slot_ptr, 12) + 1)
    let blk_size: i64 = class_to_size(cls)
    mem_write(slot_ptr, 14, mem_read(slot_ptr, 14) + blk_size)

def alloc_zeroed(size_bytes: i64) -> i64:
    # Allocates zero-initialized memory.
    let ptr: i64 = alloc_fast(size_bytes)
    if ptr == 0:
        return 0
    let words: i64 = (size_bytes + 7) / 8
    for i in 0..words:
        mem_write(ptr, i, 0)
    return ptr

def alloc_realloc(ptr: i64, old_size: i64, new_size: i64) -> i64:
    # In-place or copy reallocation.
    if ptr == 0:
        return alloc_fast(new_size)
    if new_size <= 0:
        free_fast(ptr, old_size)
        return 0
    if old_size <= 4096 and new_size <= 4096:
        if size_to_class(old_size) == size_to_class(new_size):
            return ptr
    
    let new_ptr: i64 = alloc_fast(new_size)
    if new_ptr == 0:
        return 0
    
    let copy_size: i64 = old_size if old_size < new_size else new_size
    let words: i64 = copy_size / 8
    for i in 0..words:
        mem_write(new_ptr, i, mem_read(ptr, i))
    
    free_fast(ptr, old_size)
    return new_ptr

# Convenient functional aliases
def slab_alloc(size_bytes: i64) -> i64:
    return alloc_fast(size_bytes)

def slab_free(ptr: i64, size_bytes: i64) -> void:
    free_fast(ptr, size_bytes)


# ==============================================================================
# 5. Allocator Statistics & Telemetry
# ==============================================================================

struct AllocStats:
    total_allocs: i64
    total_frees: i64
    bytes_allocated: i64
    bytes_freed: i64
    active_bytes: i64
    slab_pages: i64

def alloc_stats() -> AllocStats:
    let root: i64 = __bmb_alloc_root_get()
    if root == 0:
        return AllocStats(0, 0, 0, 0, 0, 0)
    
    let tot_allocs: i64 = 0
    let tot_frees: i64 = 0
    let tot_bytes_alloc: i64 = 0
    let tot_bytes_freed: i64 = 0
    let tot_pages: i64 = 0
    
    let table_base: i64 = root + GLOBAL_HEADER_BYTES
    for i in 0..MAX_THREAD_SLOTS:
        let slot_ptr: i64 = table_base + i * SLOT_SIZE_BYTES
        let owner: i64 = mem_read(slot_ptr, 0)
        if owner != 0:
            tot_allocs += mem_read(slot_ptr, 11)
            tot_frees += mem_read(slot_ptr, 12)
            tot_bytes_alloc += mem_read(slot_ptr, 13)
            tot_bytes_freed += mem_read(slot_ptr, 14)
            tot_pages += mem_read(slot_ptr, 15)
    
    let active: i64 = tot_bytes_alloc - tot_bytes_freed
    if active < 0:
        active = 0
    return AllocStats(tot_allocs, tot_frees, tot_bytes_alloc, tot_bytes_freed, active, tot_pages)

def alloc_print_stats() -> void:
    let s: AllocStats = alloc_stats()
    print("=== Black Mamba Thread-Local Allocator Statistics ===")
    print("Total Allocations: " + str(s.total_allocs))
    print("Total Deallocations: " + str(s.total_frees))
    print("Bytes Allocated: " + str(s.bytes_allocated) + " B")
    print("Bytes Freed: " + str(s.bytes_freed) + " B")
    print("Active Bytes: " + str(s.active_bytes) + " B")
    print("Slab Pages Carved: " + str(s.slab_pages) + " (" + str(s.slab_pages * 64) + " KB)")
    print("====================================================")


# ==============================================================================
# 6. ObjectPool: Dedicated Fixed-Size Object Cache
# ==============================================================================

struct ObjectPool:
    item_size: i64
    block_size: i64
    free_head: i64
    page_head: i64
    total_allocs: i64
    total_frees: i64
    items_per_page: i64

def pool_new(item_size: i64, prealloc_items: i64) -> ObjectPool:
    let sz: i64 = item_size
    if sz < 16:
        sz = 16
    let rem: i64 = sz % 16
    if rem != 0:
        sz += 16 - rem
    
    let usable: i64 = SLAB_PAGE_SIZE - SLAB_PAGE_HEADER_SIZE
    let per_page: i64 = usable / sz
    let p: ObjectPool = ObjectPool(item_size, sz, 0, 0, 0, 0, per_page)
    
    # Refill initial page if requested
    if prealloc_items > 0:
        let page: i64 = __bmb_mem_alloc(SLAB_PAGE_SIZE)
        if page != 0:
            mem_write(page, 0, 0)
            mem_write(page, 1, sz)
            mem_write(page, 2, per_page)
            p.page_head = page
            
            let start: i64 = page + SLAB_PAGE_HEADER_SIZE
            let limit: i64 = per_page - 1
            for i in 0..limit:
                let curr: i64 = start + i * sz
                let nxt: i64 = start + (i + 1) * sz
                mem_write(curr, 0, nxt)
            let last: i64 = start + limit * sz
            mem_write(last, 0, 0)
            p.free_head = start
    
    return p

def pool_alloc(p: ObjectPool) -> i64:
    if p.free_head == 0:
        # Carve new page
        let page: i64 = __bmb_mem_alloc(SLAB_PAGE_SIZE)
        if page == 0:
            return 0
        mem_write(page, 0, p.page_head)
        mem_write(page, 1, p.block_size)
        mem_write(page, 2, p.items_per_page)
        p.page_head = page
        
        let start: i64 = page + SLAB_PAGE_HEADER_SIZE
        let limit: i64 = p.items_per_page - 1
        for i in 0..limit:
            let curr: i64 = start + i * p.block_size
            let nxt: i64 = start + (i + 1) * p.block_size
            mem_write(curr, 0, nxt)
        let last: i64 = start + limit * p.block_size
        mem_write(last, 0, 0)
        p.free_head = start
    
    let item: i64 = p.free_head
    p.free_head = mem_read(item, 0)
    p.total_allocs += 1
    return item

def pool_free(p: ObjectPool, ptr: i64) -> void:
    if ptr == 0:
        return
    mem_write(ptr, 0, p.free_head)
    p.free_head = ptr
    p.total_frees += 1

def pool_active(p: ObjectPool) -> i64:
    let act: i64 = p.total_allocs - p.total_frees
    if act < 0:
        act = 0
    return act

def pool_destroy(p: ObjectPool) -> void:
    let curr: i64 = p.page_head
    while curr != 0:
        let nxt: i64 = mem_read(curr, 0)
        __bmb_mem_free(curr)
        curr = nxt
    p.page_head = 0
    p.free_head = 0
    p.total_allocs = 0
    p.total_frees = 0


# ==============================================================================
# 7. Arena: High-Speed Linear Bump Allocator
# ==============================================================================

struct Arena:
    base_ptr: i64
    capacity_bytes: i64
    offset: i64
    total_allocs: i64

def arena_new(capacity_bytes: i64) -> Arena:
    let cap: i64 = capacity_bytes
    if cap <= 0:
        cap = 65536
    let ptr: i64 = __bmb_mem_alloc(cap)
    return Arena(ptr, cap, 0, 0)

def arena_alloc(a: Arena, size_bytes: i64) -> i64:
    let sz: i64 = size_bytes
    let rem: i64 = sz % 16
    if rem != 0:
        sz += 16 - rem
    
    if a.offset + sz > a.capacity_bytes:
        return 0
    
    let p: i64 = a.base_ptr + a.offset
    a.offset += sz
    a.total_allocs += 1
    return p

def arena_alloc_zeroed(a: Arena, size_bytes: i64) -> i64:
    let p: i64 = arena_alloc(a, size_bytes)
    if p != 0:
        let words: i64 = (size_bytes + 7) / 8
        for i in 0..words:
            mem_write(p, i, 0)
    return p

def arena_reset(a: Arena) -> void:
    # O(1) Instant Bulk Reclamation
    a.offset = 0
    a.total_allocs = 0

def arena_destroy(a: Arena) -> void:
    if a.base_ptr != 0:
        __bmb_mem_free(a.base_ptr)
        a.base_ptr = 0
        a.offset = 0
        a.capacity_bytes = 0
        a.total_allocs = 0

def arena_used(a: Arena) -> i64:
    return a.offset

def arena_capacity(a: Arena) -> i64:
    return a.capacity_bytes

def arena_available(a: Arena) -> i64:
    return a.capacity_bytes - a.offset


# ==============================================================================
# 8. ThreadCache: Explicit Standalone Cache Instance
# ==============================================================================

struct ThreadCache:
    slot_ptr: i64
    owner_tid: i64

def thread_cache_new() -> ThreadCache:
    let tid: i64 = __bmb_thread_id()
    let slot: i64 = __bmb_mem_alloc(SLOT_SIZE_BYTES)
    mem_write(slot, 0, tid)
    return ThreadCache(slot, tid)

def thread_cache_alloc(tc: ThreadCache, size_bytes: i64) -> i64:
    if size_bytes <= 0:
        return 0
    if size_bytes > 4096:
        return __bmb_mem_alloc(size_bytes)
    
    let cls: i64 = size_to_class(size_bytes)
    let head: i64 = mem_read(tc.slot_ptr, 1 + cls)
    if head == 0:
        head = _refill_bin(tc.slot_ptr, cls)
        if head == 0:
            return 0
    
    let nxt: i64 = mem_read(head, 0)
    mem_write(tc.slot_ptr, 1 + cls, nxt)
    mem_write(tc.slot_ptr, 11, mem_read(tc.slot_ptr, 11) + 1)
    let blk: i64 = class_to_size(cls)
    mem_write(tc.slot_ptr, 13, mem_read(tc.slot_ptr, 13) + blk)
    return head

def thread_cache_free(tc: ThreadCache, ptr: i64, size_bytes: i64) -> void:
    if ptr == 0:
        return
    if size_bytes <= 0 or size_bytes > 4096:
        __bmb_mem_free(ptr)
        return
    
    let cls: i64 = size_to_class(size_bytes)
    let head: i64 = mem_read(tc.slot_ptr, 1 + cls)
    mem_write(ptr, 0, head)
    mem_write(tc.slot_ptr, 1 + cls, ptr)
    mem_write(tc.slot_ptr, 12, mem_read(tc.slot_ptr, 12) + 1)
    let blk: i64 = class_to_size(cls)
    mem_write(tc.slot_ptr, 14, mem_read(tc.slot_ptr, 14) + blk)

def thread_cache_destroy(tc: ThreadCache) -> void:
    let page: i64 = mem_read(tc.slot_ptr, 10)
    while page != 0:
        let nxt_page: i64 = mem_read(page, 0)
        __bmb_mem_free(page)
        page = nxt_page
    __bmb_mem_free(tc.slot_ptr)
    tc.slot_ptr = 0

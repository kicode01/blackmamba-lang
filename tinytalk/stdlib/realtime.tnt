# TinyTalk Standard Library: realtime.tnt
# Phase 9B (v3.1.0): Hard-Real-Time Deterministic Memory Allocator & Task Scheduler
# 100% Pure Native TinyTalk (.tnt) with Zero CPython Runtime Dependencies.
# Provides O(1) constant-time allocation guarantees and Rate-Monotonic Schedulability (RMA).

# ==============================================================================
# 1. Real-Time Scheduling Policies & Constants
# ==============================================================================

RT_POLICY_FIFO = 1
RT_POLICY_ROUND_ROBIN = 2
RT_POLICY_RATE_MONOTONIC = 3
RT_POLICY_EARLIEST_DEADLINE = 4

RT_MAX_BLOCKS = 1024

# ==============================================================================
# 2. O(1) Constant-Time Zero-Jitter Memory Pool
# ==============================================================================

struct RTBlock:
    block_id: i64
    offset_bytes: i64
    is_allocated: bool

def rt_dummy_block() -> RTBlock:
    return RTBlock(0, 0, False)

struct ZeroJitterPool:
    block_size_bytes: i64
    total_capacity: i64
    allocated_count: i64
    peak_allocated: i64
    free_cursor: i64
    blocks: Array[RTBlock]

def rt_pool_new(block_size: i64, capacity: i64) -> ZeroJitterPool:
    let cap = capacity
    if cap > RT_MAX_BLOCKS:
        cap = RT_MAX_BLOCKS
    let blks = [rt_dummy_block()] * cap
    for i in 0..cap:
        blks[i] = RTBlock(i, i * block_size, False)
    return ZeroJitterPool(block_size, cap, 0, 0, 0, blks)

def rt_pool_alloc(pool: ZeroJitterPool) -> i64:
    # O(1) allocation without search or system calls
    if pool.allocated_count >= pool.total_capacity:
        return -1
        
    let idx = pool.free_cursor
    # Find next free slot in circular buffer
    let checked = 0
    while checked < pool.total_capacity:
        let cur = (idx + checked) % pool.total_capacity
        if not pool.blocks[cur].is_allocated:
            pool.blocks[cur].is_allocated = True
            pool.allocated_count += 1
            if pool.allocated_count > pool.peak_allocated:
                pool.peak_allocated = pool.allocated_count
            pool.free_cursor = (cur + 1) % pool.total_capacity
            return pool.blocks[cur].offset_bytes
        checked += 1
        
    return -1

def rt_pool_free(pool: ZeroJitterPool, block_id: i64) -> bool:
    # O(1) constant-time deallocation
    if block_id >= 0 and block_id < pool.total_capacity:
        if pool.blocks[block_id].is_allocated:
            pool.blocks[block_id].is_allocated = False
            pool.allocated_count -= 1
            pool.free_cursor = block_id
            return True
    return False

def rt_pool_available_count(pool: ZeroJitterPool) -> i64:
    return pool.total_capacity - pool.allocated_count

# ==============================================================================
# 3. Rate-Monotonic Real-Time Task Scheduler
# ==============================================================================

struct RTTask:
    task_id: i64
    period_ns: i64
    deadline_ns: i64
    wcet_ns: i64
    priority: i64
    missed_deadlines: i64

def rt_dummy_task() -> RTTask:
    return RTTask(0, 0, 0, 0, 0, 0)

def rt_task_new(id: i64, period_ns: i64, deadline_ns: i64, wcet_ns: i64, priority: i64) -> RTTask:
    return RTTask(id, period_ns, deadline_ns, wcet_ns, priority, 0)

struct RTScheduler:
    policy: i64
    task_count: i64
    tasks: Array[RTTask]

def rt_scheduler_new(policy: i64) -> RTScheduler:
    let t = [rt_dummy_task()] * 32
    return RTScheduler(policy, 0, t)

def rt_scheduler_add_task(sched: RTScheduler, task: RTTask) -> i64:
    if sched.task_count >= len(sched.tasks):
        let new_cap = len(sched.tasks) * 2
        let new_arr = [rt_dummy_task()] * new_cap
        for i in 0..sched.task_count:
            new_arr[i] = sched.tasks[i]
        sched.tasks = new_arr
        
    sched.tasks[sched.task_count] = task
    sched.task_count += 1
    return sched.task_count

def rt_compute_utilization_ratio(sched: RTScheduler) -> f64:
    let total_u = 0.0
    for i in 0..sched.task_count:
        let t = sched.tasks[i]
        if t.period_ns > 0:
            let u_i = (t.wcet_ns * 1.0) / (t.period_ns * 1.0)
            total_u += u_i
    return total_u

def rt_is_schedulable_rma(sched: RTScheduler) -> bool:
    if sched.task_count == 0:
        return True
    let u = rt_compute_utilization_ratio(sched)
    # Liu & Layland bound: U <= n(2^(1/n) - 1). For n=1: 1.0, n=2: 0.828, n->inf: 0.693
    let bound = 0.693
    if sched.task_count == 1:
        bound = 1.0
    elif sched.task_count == 2:
        bound = 0.828
    elif sched.task_count == 3:
        bound = 0.779
    return u <= bound

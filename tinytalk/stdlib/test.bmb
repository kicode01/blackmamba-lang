# Black Mamba Standard Library: test.bmb
# Built-In Assertion Framework, Test Runner, and Nanosecond Micro-Benchmarking Harness
# 100% Pure Native Black Mamba (.bmb) with Zero External Dependencies

# ==============================================================================
# 1. String & Numerical Utilities
# ==============================================================================

def str_contains(haystack: str, needle: str) -> bool:
    h_len = len(haystack)
    n_len = len(needle)
    if n_len == 0:
        return True
    if n_len > h_len:
        return False
    limit = h_len - n_len + 1
    for i in 0..limit:
        if haystack[i:i + n_len] == needle:
            return True
    return False

def abs_f64(x: f64) -> f64:
    if x < 0.0:
        return 0.0 - x
    return x


# ==============================================================================
# 2. Test Runner & Suite Lifecycle
# ==============================================================================

struct TestRunner:
    total_asserts: i64
    passed_asserts: i64
    failed_asserts: i64
    current_suite: str
    current_test: str
    suite_count: i64
    start_ns: i64
    verbose: bool

def test_runner_new(verbose: bool) -> TestRunner:
    return TestRunner(0, 0, 0, "default", "default", 0, clock_ns(), verbose)

def test_suite(runner: TestRunner, name: str) -> i64:
    runner.current_suite = name
    runner.suite_count += 1
    if runner.verbose:
        print("")
        print("=== Test Suite: " + name + " ===")
    return 0

def test_case(runner: TestRunner, name: str) -> i64:
    runner.current_test = name
    if runner.verbose:
        print("  - " + name + "...")
    return 0


# ==============================================================================
# 3. Type-Safe Assertion Primitives
# ==============================================================================

def assert_true(r: TestRunner, cond: bool, msg: str) -> bool:
    r.total_asserts += 1
    if cond:
        r.passed_asserts += 1
        if r.verbose:
            print("    [PASS] " + msg)
        return True
    else:
        r.failed_asserts += 1
        print("    [FAIL] " + r.current_suite + " > " + r.current_test + ": " + msg)
        print("           Expected: True, Actual: False")
        return False

def assert_false(r: TestRunner, cond: bool, msg: str) -> bool:
    r.total_asserts += 1
    if not cond:
        r.passed_asserts += 1
        if r.verbose:
            print("    [PASS] " + msg)
        return True
    else:
        r.failed_asserts += 1
        print("    [FAIL] " + r.current_suite + " > " + r.current_test + ": " + msg)
        print("           Expected: False, Actual: True")
        return False

def assert_eq_i64(r: TestRunner, actual: i64, expected: i64, msg: str) -> bool:
    r.total_asserts += 1
    if actual == expected:
        r.passed_asserts += 1
        if r.verbose:
            print("    [PASS] " + msg)
        return True
    else:
        r.failed_asserts += 1
        print("    [FAIL] " + r.current_suite + " > " + r.current_test + ": " + msg)
        print("           Expected: " + str(expected) + ", Actual: " + str(actual))
        return False

def assert_ne_i64(r: TestRunner, actual: i64, unexpected: i64, msg: str) -> bool:
    r.total_asserts += 1
    if actual != unexpected:
        r.passed_asserts += 1
        if r.verbose:
            print("    [PASS] " + msg)
        return True
    else:
        r.failed_asserts += 1
        print("    [FAIL] " + r.current_suite + " > " + r.current_test + ": " + msg)
        print("           Unexpected match: " + str(actual))
        return False


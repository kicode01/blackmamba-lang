# ==============================================================================
#  BLACK MAMBA STANDARD LIBRARY: shm.tnt
#  Zero-Copy Distributed IPC & Shared Memory Primitives (Phase 8E / v2.8.0)
# ==============================================================================

struct SharedMemorySlot:
    slot_id: i64 = 0
    offset: i64 = 64
    size: i64 = 512
    is_written: bool = False

struct SharedRing:
    capacity: i64 = 1024
    head: i64 = 0
    tail: i64 = 0
    item_size: i64 = 512

fn make_shm_slot(id: i64, off: i64, sz: i64) -> SharedMemorySlot:
    return SharedMemorySlot(id, off, sz, False)

fn make_shm_ring(cap: i64, item_sz: i64) -> SharedRing:
    return SharedRing(cap, 0, 0, item_sz)

fn shm_ring_is_empty(ring: SharedRing) -> bool:
    return ring.head == ring.tail

fn shm_ring_is_full(ring: SharedRing) -> bool:
    let used = ring.tail - ring.head
    return used >= ring.capacity

fn shm_ring_len(ring: SharedRing) -> i64:
    return ring.tail - ring.head

fn shm_slot_offset(idx: i64, item_sz: i64, header_sz: i64) -> i64:
    return header_sz + (idx * item_sz)

# TinyTalk DNA Origami & Molecular Standard Library (bio.tnt)
# Nanoscale Sequence Synthesis and Thermodynamic Evaluation

struct OligoSpec:
    name: str
    length: i64
    tm_celsius: f64
    gc_percent: f64

def calculate_rough_tm(length: i64, gc_count: i64) -> f64:
    if length <= 0:
        return 0.0
    return 64.9 + 41.0 * ((gc_count * 1.0) - 16.4) / (length * 1.0)

def make_oligo_spec(name: str, length: i64, tm: f64, gc: f64) -> OligoSpec:
    return OligoSpec(name, length, tm, gc)

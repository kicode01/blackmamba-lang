# TinyTalk Wire RPC Module (rpc.tnt)
# Phase 11C: Zero-Copy Binary Wire RPC (v4.2.0)

struct RPCHeader:
    magic: int
    version: int
    flags: int
    msg_id: int
    method_id: int
    payload_len: int
    checksum: int
    reserved: int

def rpc_header_size() -> int:
    return 32

def rpc_is_request(flags: int) -> bool:
    return (flags & 1) != 0

def rpc_is_response(flags: int) -> bool:
    return (flags & 2) != 0

# Black Mamba Standard Library: async.bmb
# High-performance, zero-CPython-overhead cooperative asynchronous Event Loop & Task Scheduler.
# 100% pure native Black Mamba (.bmb) running bare-metal across JIT, Windows PE32+, and Linux ELF64.

# ==============================================================================
# 1. Asynchronous Task States & Representation
# ==============================================================================

ASYNC_PENDING = 0
ASYNC_RUNNING = 1
ASYNC_COMPLETED = 2
ASYNC_FAILED = 3

struct AsyncTask:
    id: i64
    fn_ptr: i64
    arg: i64
    status: i64
    result: i64
    wake_time_ns: i64
    is_ready: i64

struct AsyncLoop:
    capacity: i64
    task_count: i64
    tasks: Array[AsyncTask]
    current_idx: i64
    is_running: i64
    completed_count: i64
    tick_count: i64


# ==============================================================================
# 2. Event Loop Lifecycle
# ==============================================================================

def async_loop_new(capacity: i64) -> AsyncLoop:
    # Constructs an asynchronous event loop with a pre-allocated task table.
    cap = capacity
    if cap <= 0:
        cap = 256
    dummy = AsyncTask(-1, 0, 0, 0, 0, 0, 0)
    arr = [dummy] * cap
    for i in 0..cap:
        arr[i] = AsyncTask(i, 0, 0, 0, 0, 0, 0)
    return AsyncLoop(cap, 0, arr, 0, 1, 0, 0)

def async_loop_cap(loop: AsyncLoop) -> i64:
    # Returns maximum task capacity of the event loop.
    return loop.capacity

def async_loop_tasks_len(loop: AsyncLoop) -> i64:
    # Returns total count of registered tasks (pending + running + completed).
    return loop.task_count

def async_loop_completed_len(loop: AsyncLoop) -> i64:
    # Returns count of completed tasks.
    return loop.completed_count

def async_loop_is_running(loop: AsyncLoop) -> bool:
    # Returns True if the event loop is active and accepting executions.
    return loop.is_running != 0

def async_stop(loop: AsyncLoop):
    # Gracefully stops the event loop reactor.
    loop.is_running = 0


# ==============================================================================
# 3. Task Scheduling
# ==============================================================================

def async_spawn(loop: AsyncLoop, fn_ptr: i64, arg: i64) -> i64:
    # Spawns a cooperative asynchronous task executing fn_ptr(arg).
    # Returns the assigned task ID, or -1 if loop capacity is exhausted.
    if loop.task_count >= loop.capacity:
        return -1
    tid = loop.task_count
    t = loop.tasks[tid]
    t.id = tid
    t.fn_ptr = fn_ptr
    t.arg = arg
    t.status = ASYNC_PENDING
    t.result = 0
    t.wake_time_ns = 0
    t.is_ready = 1
    loop.task_count += 1
    return tid

def async_delay(loop: AsyncLoop, delay_ms: i64, fn_ptr: i64, arg: i64) -> i64:
    # Schedules a task to execute after delay_ms milliseconds.
    # Uses high-precision monotonic hardware clock (clock_ns) for zero-drift timing.
    if loop.task_count >= loop.capacity:
        return -1
    tid = loop.task_count
    t = loop.tasks[tid]
    t.id = tid
    t.fn_ptr = fn_ptr
    t.arg = arg
    t.status = ASYNC_PENDING
    t.result = 0
    t.wake_time_ns = clock_ns() + (delay_ms * 1000000)
    t.is_ready = 0
    loop.task_count += 1
    return tid

def async_task_status(loop: AsyncLoop, task_id: i64) -> i64:
    # Returns the execution status of task_id (PENDING=0, RUNNING=1, COMPLETED=2, FAILED=3).
    if task_id < 0 or task_id >= loop.task_count:
        return -1
    return loop.tasks[task_id].status

def async_task_result(loop: AsyncLoop, task_id: i64) -> i64:
    # Returns the computed return value of task_id.
    if task_id < 0 or task_id >= loop.task_count:
        return 0
    return loop.tasks[task_id].result

def async_task_is_done(loop: AsyncLoop, task_id: i64) -> bool:
    # Returns True if task_id has finished execution (COMPLETED or FAILED).
    st = async_task_status(loop, task_id)
    return st == ASYNC_COMPLETED or st == ASYNC_FAILED


# ==============================================================================
# 4. Reactor Execution Engine
# ==============================================================================

def async_tick(loop: AsyncLoop) -> i64:
    # Executes one cooperative scheduling round across all scheduled tasks.
    # Returns the count of tasks that completed execution during this tick.
    if loop.is_running == 0 or loop.task_count == 0:
        return 0

    now_ns = clock_ns()
    executed_in_tick = 0
    total = loop.task_count

    for i in 0..total:
        t = loop.tasks[i]
        if t.status == ASYNC_PENDING:
            # Check timer wake requirement for delayed tasks
            if t.wake_time_ns > 0 and now_ns < t.wake_time_ns:
                continue

            # Execute task via indirect function pointer call
            t.status = ASYNC_RUNNING
            task_fn = t.fn_ptr
            res = task_fn(t.arg)
            t.result = res
            t.status = ASYNC_COMPLETED
            loop.completed_count += 1
            executed_in_tick += 1

    loop.tick_count += 1
    return executed_in_tick

def async_run_until_complete(loop: AsyncLoop, target_task_id: i64) -> i64:
    # Drives the event loop reactor until target_task_id finishes.
    # Returns the target task's integer result.
    if target_task_id < 0 or target_task_id >= loop.task_count:
        return -1

    backoff = 0
    while loop.is_running != 0 and not async_task_is_done(loop, target_task_id):
        executed = async_tick(loop)
        if executed == 0:
            # Cooperative backoff to prevent burning 100% CPU on waiting timers
            if backoff < 20:
                pass
            elif backoff < 100:
                pass
            else:
                pass
            backoff += 1
        else:
            backoff = 0

    return async_task_result(loop, target_task_id)

def async_run_all(loop: AsyncLoop) -> i64:
    # Runs the event loop until all registered tasks have completed.
    # Returns total count of completed tasks.
    backoff = 0
    while loop.is_running != 0 and loop.completed_count < loop.task_count:
        executed = async_tick(loop)
        if executed == 0:
            backoff += 1
        else:
            backoff = 0
    return loop.completed_count

# Black Mamba Standard Library: iter.bmb
# High-performance iterator combinators, permutations, and memoization
# 100% pure native Black Mamba | Zero-cost abstractions | Cache-friendly transformations

def chain_i64(a: Array[i64], len_a: i64, b: Array[i64], len_b: i64) -> Array[i64]:
    total_len = len_a + len_b
    res = [0] * total_len
    for i in 0..len_a:
        res[i] = a[i]
    for j in 0..len_b:
        res[len_a + j] = b[j]
    return res

def take_i64(a: Array[i64], n: i64, total: i64) -> Array[i64]:
    actual_n = n
    if actual_n > total:
        actual_n = total
    if actual_n < 0:
        actual_n = 0
    res = [0] * actual_n
    for i in 0..actual_n:
        res[i] = a[i]
    return res

def drop_i64(a: Array[i64], n: i64, total: i64) -> Array[i64]:
    skip = n
    if skip < 0:
        skip = 0
    rem = total - skip
    if rem < 0:
        rem = 0
    res = [0] * rem
    for i in 0..rem:
        res[i] = a[skip + i]
    return res

def repeat_i64(val: i64, times: i64) -> Array[i64]:
    count = times
    if count < 0:
        count = 0
    res = [0] * count
    for i in 0..count:
        res[i] = val
    return res

def accumulate_sum(a: Array[i64], count: i64) -> Array[i64]:
    res = [0] * count
    running = 0
    for i in 0..count:
        running += a[i]
        res[i] = running
    return res

def permutations_count(n: i64, r: i64) -> i64:
    if r < 0 or r > n:
        return 0
    res = 1
    for i in 0..r:
        res *= (n - i)
    return res

def combinations_count(n: i64, r: i64) -> i64:
    if r < 0 or r > n:
        return 0
    k = r
    if k > n - k:
        k = n - k
    num = 1
    den = 1
    for i in 0..k:
        num *= (n - i)
        den *= (i + 1)
    return num // den

def cartesian_product_len(len_a: i64, len_b: i64) -> i64:
    return len_a * len_b

def cartesian_product_idx_a(flat_idx: i64, len_b: i64) -> i64:
    if len_b <= 0:
        return 0
    return flat_idx // len_b

def cartesian_product_idx_b(flat_idx: i64, len_b: i64) -> i64:
    if len_b <= 0:
        return 0
    return flat_idx % len_b

# --- Memoization Cache Table (functools.lru_cache parity) ---

struct MemoCache:
    keys: Array[i64]
    values: Array[i64]
    valid: Array[bool]
    capacity: i64
    hits: i64
    misses: i64

    def get(self, key: i64, default_val: i64 = -1) -> i64:
        idx = (key % self.capacity + self.capacity) % self.capacity
        if self.valid[idx] and self.keys[idx] == key:
            self.hits += 1
            return self.values[idx]
        self.misses += 1
        return default_val

    def put(self, key: i64, val: i64) -> bool:
        idx = (key % self.capacity + self.capacity) % self.capacity
        self.keys[idx] = key
        self.values[idx] = val
        self.valid[idx] = True
        return True

    def has(self, key: i64) -> bool:
        idx = (key % self.capacity + self.capacity) % self.capacity
        return self.valid[idx] and self.keys[idx] == key

    def clear(self) -> i64:
        for i in 0..self.capacity:
            self.valid[i] = False
        self.hits = 0
        self.misses = 0
        return 0

def new_memo_cache(capacity: i64 = 1024) -> MemoCache:
    cap = capacity
    if cap <= 0:
        cap = 64
    k_arr = [0] * cap
    v_arr = [0] * cap
    val_arr = [False] * cap
    return MemoCache(k_arr, v_arr, val_arr, cap, 0, 0)

def memo_cache_new(capacity: i64 = 1024) -> MemoCache:
    return new_memo_cache(capacity)

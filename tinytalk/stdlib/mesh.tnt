# TinyTalk Zero-Trust Mesh Network Module (mesh.tnt)
# Phase 11D: Encrypted Mesh Tunnels & XOR DHT Routing (v4.3.0)

struct MeshPeer:
    node_id: str
    public_key: str
    active: bool

struct MeshEnvelope:
    sender_id: str
    recipient_id: str
    seq: i64
    payload_len: i64

fn mesh_peer_new(node_id: str, pub_key: str) -> MeshPeer:
    return MeshPeer(node_id, pub_key, True)

fn mesh_is_valid_seq(seq: i64, last_seen: i64) -> bool:
    return seq > last_seen

# TinyTalk Relativistic Interplanetary CRDT Standard Library (relativistic.tnt)
# Lattice Join Invariants and Eventual Consistency Accounting

struct CRDTSummary:
    node_id: str
    counter_value: i64

def make_crdt_summary(node: str, val: i64) -> CRDTSummary:
    return CRDTSummary(node, val)

def select_max_timestamp(t1: f64, t2: f64) -> f64:
    if t1 >= t2:
        return t1
    return t2

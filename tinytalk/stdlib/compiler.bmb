# Black Mamba Standard Library: compiler.bmb
# Vector 6: Self-Hosting Compiler Bootstrap (Phase A: Lexer & Pratt Parser)
# 100% Pure Native Black Mamba (.bmb) with Zero CPython Runtime Dependencies.
# Indentation-Aware Lexer, Top-Down Operator Precedence (Pratt) Parser, Unified AST.

# ==============================================================================
# 1. Token Type Constants
# ==============================================================================

TOK_EOF = 0
TOK_IDENT = 1
TOK_INT = 2
TOK_FLOAT = 3
TOK_STRING = 4
TOK_BOOL = 5

# Keywords
TOK_DEF = 10
TOK_FN = 11
TOK_STRUCT = 12
TOK_CLASS = 13
TOK_RETURN = 14
TOK_IF = 15
TOK_ELIF = 16
TOK_ELSE = 17
TOK_WHILE = 18
TOK_FOR = 19
TOK_PAR = 20
TOK_IN = 21
TOK_BREAK = 22
TOK_CONTINUE = 23
TOK_PASS = 24
TOK_MATCH = 25
TOK_CASE = 26
TOK_LET = 27
TOK_CONST = 28
TOK_MUT = 29
TOK_AND = 30
TOK_OR = 31
TOK_NOT = 32
TOK_TRUE = 33
TOK_FALSE = 34
TOK_IMPORT = 35
TOK_FROM = 36
TOK_AS = 37

# Operators
TOK_PLUS = 40       # +
TOK_MINUS = 41      # -
TOK_STAR = 42       # *
TOK_SLASH = 43      # /
TOK_DSLASH = 44     # //
TOK_PERCENT = 45    # %
TOK_POW = 46        # **
TOK_PIPE_GT = 47    # |>
TOK_ARROW = 48      # ->
TOK_RANGE = 49      # ..
TOK_RANGE_INC = 50  # ..=
TOK_AMP = 51        # &
TOK_PIPE = 52       # |
TOK_CARET = 53      # ^
TOK_TILDE = 54      # ~
TOK_LSHIFT = 55     # <<
TOK_RSHIFT = 56     # >>

# Comparisons
TOK_EQ = 60         # ==
TOK_NE = 61         # !=
TOK_LT = 62         # <
TOK_LE = 63         # <=
TOK_GT = 64         # >
TOK_GE = 65         # >=

# Assignments
TOK_ASSIGN = 70     # =
TOK_WALRUS = 71     # :=
TOK_PLUS_EQ = 72    # +=
TOK_MINUS_EQ = 73   # -=
TOK_STAR_EQ = 74    # *=
TOK_SLASH_EQ = 75   # /=

# Delimiters
TOK_LPAREN = 80     # (
TOK_RPAREN = 81     # )
TOK_LBRACKET = 82   # [
TOK_RBRACKET = 83   # ]
TOK_LBRACE = 84     # {
TOK_RBRACE = 85     # }
TOK_COLON = 86      # :
TOK_COMMA = 87      # ,
TOK_DOT = 88        # .
TOK_SEMI = 89       # ;
TOK_AT = 90         # @

# Indentation Structure
TOK_NEWLINE = 95
TOK_INDENT = 96
TOK_DEDENT = 97

# ==============================================================================
# 2. AST Node Kinds & Precedence Levels
# ==============================================================================

AST_MODULE = 100
AST_FN_DEF = 101
AST_STRUCT_DEF = 102
AST_PARAM = 103
AST_STRUCT_FIELD = 104
AST_IF = 105
AST_WHILE = 106
AST_FOR = 107
AST_RETURN = 108
AST_ASSIGN = 109
AST_EXPR_STMT = 110
AST_BLOCK = 111
AST_IMPORT = 112
AST_PASS = 113
AST_BREAK = 114
AST_CONTINUE = 115

AST_BIN_OP = 200
AST_UNARY_OP = 201
AST_CALL = 202
AST_INDEX = 203
AST_FIELD_ACCESS = 204
AST_RANGE = 205
AST_PIPE = 206
AST_ARRAY_LIT = 207

AST_IDENT = 300
AST_INT_LIT = 301
AST_FLOAT_LIT = 302
AST_STR_LIT = 303
AST_BOOL_LIT = 304

# Pratt Precedence Hierarchy (higher binds tighter)
PREC_NONE = 0
PREC_PIPE = 15       # |>
PREC_ASSIGN = 20     # =
PREC_OR = 30         # or
PREC_AND = 35        # and
PREC_EQUALITY = 40   # ==, !=
PREC_RELATIONAL = 50 # <, <=, >, >=
PREC_RANGE = 55      # .., ..=
PREC_BIT_OR = 56     # |
PREC_BIT_XOR = 57    # ^
PREC_BIT_AND = 58    # &
PREC_SHIFT = 59      # <<, >>
PREC_TERM = 60       # +, -
PREC_FACTOR = 70     # *, /, //, %
PREC_UNARY = 80      # -, +, ~, not
PREC_POWER = 85      # **
PREC_POSTFIX = 90    # (), [], .

# ==============================================================================
# 3. Core Data Structures: Token & ASTNode
# ==============================================================================

struct Token:
    type_id: i64
    value: str
    int_val: i64
    float_val: f64
    line: i64
    col: i64

def token_new(type_id: i64, val: str, i_val: i64, f_val: f64, line: i64, col: i64) -> Token:
    return Token(type_id, val, i_val, f_val, line, col)

struct ASTNode:
    kind: i64
    name: str
    int_val: i64
    float_val: f64
    str_val: str
    op: str
    children: Array[ASTNode]
    child_count: i64
    child_cap: i64
    line: i64

def ast_dummy() -> ASTNode:
    let empty_children = [ASTNode(0, "", 0, 0.0, "", "", [], 0, 0, 0)]
    return ASTNode(0, "", 0, 0.0, "", "", empty_children, 0, 0, 0)

def node_new(kind: i64, name: str, int_val: i64, float_val: f64, str_val: str, op: str, line: i64) -> ASTNode:
    let c = [ast_dummy()] * 4
    return ASTNode(kind, name, int_val, float_val, str_val, op, c, 0, 4, line)

def node_add_child(parent: ASTNode, child: ASTNode) -> i64:
    if parent.child_count >= parent.child_cap:
        let new_cap = parent.child_cap * 2
        let new_arr = [ast_dummy()] * new_cap
        for i in 0..parent.child_count:
            new_arr[i] = parent.children[i]
        parent.children = new_arr
        parent.child_cap = new_cap
    parent.children[parent.child_count] = child
    parent.child_count += 1
    return parent.child_count

def ast_node_count(node: ASTNode) -> i64:
    let count = 1
    for i in 0..node.child_count:
        count += ast_node_count(node.children[i])
    return count


# TinyTalk Standard Library: `ast_graph`
# Native Content-Addressed AST Symbol Metadata & Surgical Delta Patch Primitives.

struct ASTSpan:
    start_line: i64 = 1
    end_line: i64 = 1

struct ASTSymbolMeta:
    module_name: str = "main"
    symbol_name: str = ""
    parent_name: str = ""
    kind: str = "fn"
    signature: str = ""
    span: ASTSpan

struct ASTDeltaSpec:
    op: str = "REPLACE_SYMBOL"
    target_uri: str = ""
    compact_code: str = ""
    meta: ASTSymbolMeta

fn format_ast_uri(module_name: str, symbol_name: str, parent_name: str) -> str:
    if len(parent_name) > 0:
        return "tnt://" + module_name + "/" + parent_name + "/" + symbol_name
    return "tnt://" + module_name + "/" + symbol_name

fn make_symbol_meta(module_name: str, symbol_name: str, parent_name: str, kind: str, sig: str, start_ln: i64, end_ln: i64) -> ASTSymbolMeta:
    sp = ASTSpan(start_ln, end_ln)
    return ASTSymbolMeta(module_name, symbol_name, parent_name, kind, sig, sp)

fn make_delta_spec(op: str, meta: ASTSymbolMeta, compact_code: str) -> ASTDeltaSpec:
    uri = format_ast_uri(meta.module_name, meta.symbol_name, meta.parent_name)
    return ASTDeltaSpec(op, uri, compact_code, meta)

fn compute_token_savings_pct(full_tokens: i64, delta_tokens: i64) -> f64:
    if full_tokens <= 0:
        return 0.0
    saved = full_tokens - delta_tokens
    if saved < 0:
        return 0.0
    return (float(saved) * 100.0) / float(full_tokens)

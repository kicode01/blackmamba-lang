# TinyTalk Standard Library: spec.tnt
# Phase 9C: Formal Codebase Specification & Property-Based Mutation Fuzzing
# 100% Pure Native TinyTalk (.tnt) with Zero CPython Runtime Dependencies.

struct GenConfig:
    min_val: i64
    max_val: i64
    seed: i64
    max_shrink_steps: i64

struct SpecResult:
    passed: bool
    tests_run: i64
    counterexample: i64
    shrunk_steps: i64

def spec_lcg_next(current_seed: i64) -> i64:
    let next_seed = (current_seed * 1103515245 + 12345) & 2147483647
    return next_seed

def gen_i64(min_v: i64, max_v: i64, seed: i64) -> i64:
    let next_seed = spec_lcg_next(seed)
    let range_span = max_v - min_v + 1
    if range_span <= 0:
        return min_v
    let val = min_v + (next_seed % range_span)
    return val

def shrink_i64(failing_val: i64, target_boundary: i64) -> i64:
    if failing_val == target_boundary:
        return failing_val
    let diff = failing_val - target_boundary
    let step = diff // 2
    return failing_val - step

def spec_check_commutativity_add(a: i64, b: i64) -> bool:
    return (a + b) == (b + a)

def spec_check_associativity_add(a: i64, b: i64, c: i64) -> bool:
    return ((a + b) + c) == (a + (b + c))

def spec_check_identity_add(a: i64) -> bool:
    return (a + 0) == a

def spec_check_idempotence_abs(a: i64) -> bool:
    let r1 = a
    if r1 < 0:
        r1 = -r1
    let r2 = r1
    if r2 < 0:
        r2 = -r2
    return r1 == r2

def spec_run_addition_laws(iterations: i64, initial_seed: i64) -> SpecResult:
    let current_seed = initial_seed
    let i = 0
    let res = SpecResult(True, 0, 0, 0)
    
    while i < iterations:
        current_seed = spec_lcg_next(current_seed)
        let a = gen_i64(-10000, 10000, current_seed)
        current_seed = spec_lcg_next(current_seed)
        let b = gen_i64(-10000, 10000, current_seed)
        current_seed = spec_lcg_next(current_seed)
        let c = gen_i64(-10000, 10000, current_seed)
        
        let comm = spec_check_commutativity_add(a, b)
        let assoc = spec_check_associativity_add(a, b, c)
        let ident = spec_check_identity_add(a)
        
        if not (comm and assoc and ident):
            res.passed = False
            res.counterexample = a
            res.tests_run = i + 1
            return res
            
        i = i + 1
        
    res.tests_run = iterations
    return res

def spec_find_minimal_counterexample(threshold: i64, start_val: i64) -> i64:
    let curr = start_val
    if curr <= threshold:
        return curr
    while curr > threshold + 1:
        let candidate = shrink_i64(curr, threshold)
        if candidate > threshold:
            curr = candidate
        else:
            curr = curr - 1
    return curr

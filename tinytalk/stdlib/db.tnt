# TinyTalk Standard Library: db.tnt
# High-Performance Database Engine & Fluent Query Interface for TinyTalk (.tnt)
# Zero-dependency, thread-safe, ACID relational storage & query builder.

from sql import (
    SqlTable,
    SqlDb,
    SqlResult,
    sql_open,
    sql_open_file,
    sql_save,
    sql_exec,
    sql_cell,
    sql_cell_int,
    sql_format_table,
)

# ==============================================================================
# 1. Query Builder Structures
# ==============================================================================

struct Query:
    table_name: str
    has_where: i64
    where_col: str
    where_op: str
    where_val: str
    has_order: i64
    order_col: str
    order_desc: i64
    limit_count: i64

# ==============================================================================
# 2. Connection Management
# ==============================================================================

def db_open(path: str = ":memory:") -> SqlDb:
    if path != ":memory:":
        let loaded: SqlDb = sql_open_file(path)
        if loaded.table_count > 0:
            return loaded
    return sql_open()

def db_save(db: SqlDb, path: str) -> bool:
    if path == ":memory:":
        return True
    return sql_save(db, path)

# ==============================================================================
# 3. Direct SQL Execution
# ==============================================================================

def db_execute(db: SqlDb, sql_text: str) -> bool:
    let res: SqlResult = sql_exec(db, sql_text)
    return res.ok

def db_query(db: SqlDb, sql_text: str) -> SqlResult:
    return sql_exec(db, sql_text)

def db_cell(res: SqlResult, row: i64, col: i64) -> str:
    return sql_cell(res, row, col)

# ==============================================================================
# 4. Fluent Query Builder
# ==============================================================================

def query_new(table: str) -> Query:
    return Query(table, 0, "", "", "", 0, "", 0, -1)

def query_where(q: Query, col: str, op: str, val: str) -> Query:
    q.has_where = 1
    q.where_col = col
    q.where_op = op
    q.where_val = val
    return q

def query_order_by(q: Query, col: str, desc: i64 = 0) -> Query:
    q.has_order = 1
    q.order_col = col
    q.order_desc = desc
    return q

def query_limit(q: Query, n: i64) -> Query:
    q.limit_count = n
    return q

def query_to_sql(q: Query) -> str:
    let sql: str = "SELECT * FROM " + q.table_name
    if q.has_where == 1:
        sql = sql + " WHERE " + q.where_col + " " + q.where_op + " " + q.where_val
    if q.has_order == 1:
        sql = sql + " ORDER BY " + q.order_col
        if q.order_desc == 1:
            sql = sql + " DESC"
        else:
            sql = sql + " ASC"
    if q.limit_count >= 0:
        sql = sql + " LIMIT " + str(q.limit_count)
    return sql

def query_all(db: SqlDb, q: Query) -> SqlResult:
    let sql: str = query_to_sql(q)
    return sql_exec(db, sql)

def query_count(db: SqlDb, q: Query) -> i64:
    let sql: str = "SELECT COUNT(*) FROM " + q.table_name
    if q.has_where == 1:
        sql = sql + " WHERE " + q.where_col + " " + q.where_op + " " + q.where_val
    let res: SqlResult = sql_exec(db, sql)
    if res.ok and res.row_count > 0:
        let val_s: str = sql_cell(res, 0, 0)
        let num: i64 = 0
        let slen: i64 = len(val_s)
        for i in 0..slen:
            let c: i64 = ord(val_s[i])
            if c >= 48 and c <= 57:
                num = num * 10 + (c - 48)
        return num
    return 0

# ==============================================================================
# 5. Data Manipulation & Formatting Helpers
# ==============================================================================

def db_insert(db: SqlDb, table: str, vals: Array[str]) -> bool:
    let nvals: i64 = len(vals)
    if nvals == 0:
        return False
    let val_str: str = ""
    for i in 0..nvals:
        if i > 0:
            val_str = val_str + ", "
        val_str = val_str + vals[i]
    let sql: str = "INSERT INTO " + table + " VALUES (" + val_str + ");"
    return db_execute(db, sql)

def db_format_ascii(res: SqlResult) -> str:
    return sql_format_table(res)

def db_to_json(res: SqlResult) -> str:
    if not res.ok:
        return "[]"
    let json_out: str = "[\n"
    for r in 0..res.row_count:
        json_out = json_out + "  {\n"
        for c in 0..res.col_count:
            let col_name: str = res.col_names[c]
            let val: str = sql_cell(res, r, c)
            json_out = json_out + "    \"" + col_name + "\": \"" + val + "\""
            if c + 1 < res.col_count:
                json_out = json_out + ","
            json_out = json_out + "\n"
        json_out = json_out + "  }"
        if r + 1 < res.row_count:
            json_out = json_out + ","
        json_out = json_out + "\n"
    json_out = json_out + "]"
    return json_out

# Black Mamba Standard Library: tls.bmb
# Pure Native TLS 1.3 Key Schedule, Authenticated Record Framing & ASN.1 DER X.509 Engine.
# Implements:
#   1. RFC 2104 Byte-Buffer HMAC-SHA256 & Constant-Time Tag Verification
#   2. RFC 5869 HKDF-Extract / HKDF-Expand & RFC 8446 TLS 1.3 Key Schedule
#   3. RFC 8439 20-Round ChaCha20 Stream Cipher & Authenticated TLS 1.3 Record Seal/Open
#   4. RFC 8446 TLS 1.3 ClientHello Wire Packet Builder (SNI + supported_versions + X25519 key_share)
#   5. ITU-T X.690 ASN.1 DER TLV Parser, X.509v3 Certificate Inspector & SHA-256 Pinning
# 100% Pure Black Mamba (.bmb) — Zero OpenSSL / CPython Runtime Dependencies.

from hash import sha256_buffer, rotl32, hex_byte

# ==============================================================================
# 1. Byte Array Utilities & Constant-Time Primitives
# ==============================================================================

def tls_bytes_from_str(s: str) -> Array[i64]:
    let n: i64 = len(s)
    if n == 0:
        let empty: Array[i64] = []
        return empty
    let out: Array[i64] = [0] * n
    for i in 0..n:
        out[i] = ord(s[i]) & 255
    return out

def tls_bytes_to_str(buf: Array[i64], length: i64) -> str:
    let s: str = ""
    for i in 0..length:
        s = s + chr(buf[i] & 255)
    return s

def tls_bytes_to_hex(buf: Array[i64], length: i64) -> str:
    let s: str = ""
    for i in 0..length:
        s = s + hex_byte(buf[i] & 255)
    return s

def tls_ct_equal(a: Array[i64], b: Array[i64], length: i64) -> bool:
    let diff: i64 = 0
    for i in 0..length:
        diff = diff | ((a[i] ^ b[i]) & 255)
    return diff == 0

def sha256_bytes(buf: Array[i64], length: i64) -> Array[i64]:
    let words: Array[i64] = sha256_buffer(buf, length)
    let out: Array[i64] = [0] * 32
    for i in 0..8:
        let w: i64 = words[i]
        out[i * 4] = (w >> 24) & 255
        out[i * 4 + 1] = (w >> 16) & 255
        out[i * 4 + 2] = (w >> 8) & 255
        out[i * 4 + 3] = w & 255
    return out

def hmac_sha256_bytes(key: Array[i64], key_len: i64, msg: Array[i64], msg_len: i64) -> Array[i64]:
    let k_block: Array[i64] = [0] * 64
    if key_len > 64:
        let kh: Array[i64] = sha256_bytes(key, key_len)
        for i in 0..32:
            k_block[i] = kh[i]
    else:
        for i in 0..key_len:
            k_block[i] = key[i] & 255

    let inner_len: i64 = 64 + msg_len
    let inner: Array[i64] = [0] * inner_len
    for i in 0..64:
        inner[i] = k_block[i] ^ 0x36
    for i in 0..msg_len:
        inner[64 + i] = msg[i] & 255
    let inner_hash: Array[i64] = sha256_bytes(inner, inner_len)

    let outer: Array[i64] = [0] * 96
    for i in 0..64:
        outer[i] = k_block[i] ^ 0x5c
    for i in 0..32:
        outer[64 + i] = inner_hash[i]
    return sha256_bytes(outer, 96)

# ==============================================================================
# 2. RFC 5869 HKDF-SHA256 & RFC 8446 TLS 1.3 Key Schedule
# ==============================================================================

def hkdf_extract(salt: Array[i64], salt_len: i64, ikm: Array[i64], ikm_len: i64) -> Array[i64]:
    if salt_len <= 0:
        let zero_salt: Array[i64] = [0] * 32
        return hmac_sha256_bytes(zero_salt, 32, ikm, ikm_len)
    return hmac_sha256_bytes(salt, salt_len, ikm, ikm_len)

def hkdf_expand(prk: Array[i64], info: Array[i64], info_len: i64, out_len: i64) -> Array[i64]:
    let n_blocks: i64 = (out_len + 31) // 32
    let okm: Array[i64] = [0] * out_len
    let prev: Array[i64] = [0] * 32
    let prev_len: i64 = 0
    let pos: i64 = 0

    for blk in 1..=n_blocks:
        let in_len: i64 = prev_len + info_len + 1
        let in_buf: Array[i64] = [0] * in_len
        for i in 0..prev_len:
            in_buf[i] = prev[i]
        for j in 0..info_len:
            in_buf[prev_len + j] = info[j] & 255
        in_buf[prev_len + info_len] = blk & 255
        let t_blk: Array[i64] = hmac_sha256_bytes(prk, 32, in_buf, in_len)
        for k in 0..32:
            prev[k] = t_blk[k]
            if pos < out_len:
                okm[pos] = t_blk[k]
                pos += 1
        prev_len = 32
    return okm

def tls13_hkdf_expand_label(secret: Array[i64], label: str, context: Array[i64], ctx_len: i64, out_len: i64) -> Array[i64]:
    let full_label: str = "tls13 " + label
    let lbl_len: i64 = len(full_label)
    let info_len: i64 = 2 + 1 + lbl_len + 1 + ctx_len
    let info: Array[i64] = [0] * info_len
    info[0] = (out_len >> 8) & 255
    info[1] = out_len & 255
    info[2] = lbl_len & 255
    for i in 0..lbl_len:
        info[3 + i] = ord(full_label[i]) & 255
    info[3 + lbl_len] = ctx_len & 255
    for j in 0..ctx_len:
        info[4 + lbl_len + j] = context[j] & 255
    return hkdf_expand(secret, info, info_len, out_len)

struct Tls13Keys:
    handshake_secret: Array[i64]
    client_key: Array[i64]
    client_iv: Array[i64]
    server_key: Array[i64]
    server_iv: Array[i64]

def tls13_derive_handshake_keys(shared_secret: Array[i64], transcript_hash: Array[i64]) -> Tls13Keys:
    let zeros32: Array[i64] = [0] * 32
    let empty_bytes: Array[i64] = []
    let empty_hash: Array[i64] = sha256_bytes(empty_bytes, 0)
    let early_secret: Array[i64] = hkdf_extract(zeros32, 32, zeros32, 32)
    let derived: Array[i64] = tls13_hkdf_expand_label(early_secret, "derived", empty_hash, 32, 32)
    let hs_secret: Array[i64] = hkdf_extract(derived, 32, shared_secret, 32)

    let c_hs_traffic: Array[i64] = tls13_hkdf_expand_label(hs_secret, "c hs traffic", transcript_hash, 32, 32)
    let s_hs_traffic: Array[i64] = tls13_hkdf_expand_label(hs_secret, "s hs traffic", transcript_hash, 32, 32)

    let c_key: Array[i64] = tls13_hkdf_expand_label(c_hs_traffic, "key", empty_bytes, 0, 32)
    let c_iv: Array[i64] = tls13_hkdf_expand_label(c_hs_traffic, "iv", empty_bytes, 0, 12)
    let s_key: Array[i64] = tls13_hkdf_expand_label(s_hs_traffic, "key", empty_bytes, 0, 32)
    let s_iv: Array[i64] = tls13_hkdf_expand_label(s_hs_traffic, "iv", empty_bytes, 0, 12)
    return Tls13Keys(hs_secret, c_key, c_iv, s_key, s_iv)

# ==============================================================================
# 3. RFC 8439 ChaCha20 20-Round Cipher & Authenticated TLS 1.3 Record Framing
# ==============================================================================

def _chacha_qr(st: Array[i64], a: i64, b: i64, c: i64, d: i64) -> i64:
    st[a] = (st[a] + st[b]) & 0xFFFFFFFF
    st[d] = rotl32(st[d] ^ st[a], 16)

    st[c] = (st[c] + st[d]) & 0xFFFFFFFF
    st[b] = rotl32(st[b] ^ st[c], 12)

    st[a] = (st[a] + st[b]) & 0xFFFFFFFF
    st[d] = rotl32(st[d] ^ st[a], 8)

    st[c] = (st[c] + st[d]) & 0xFFFFFFFF
    st[b] = rotl32(st[b] ^ st[c], 7)
    return 0

def _le32(buf: Array[i64], off: i64) -> i64:
    let b0: i64 = buf[off] & 255
    let b1: i64 = buf[off + 1] & 255
    let b2: i64 = buf[off + 2] & 255
    let b3: i64 = buf[off + 3] & 255
    return (b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)) & 0xFFFFFFFF

def chacha20_block(key32: Array[i64], counter: i64, nonce12: Array[i64]) -> Array[i64]:
    let init_st: Array[i64] = [0] * 16
    init_st[0] = 0x61707865
    init_st[1] = 0x3320646e
    init_st[2] = 0x79622d32
    init_st[3] = 0x6b206574
    for k in 0..8:
        init_st[4 + k] = _le32(key32, k * 4)
    init_st[12] = counter & 0xFFFFFFFF
    init_st[13] = _le32(nonce12, 0)
    init_st[14] = _le32(nonce12, 4)
    init_st[15] = _le32(nonce12, 8)

    let work: Array[i64] = [0] * 16
    for i in 0..16:
        work[i] = init_st[i]

    for r in 0..10:
        _chacha_qr(work, 0, 4, 8, 12)
        _chacha_qr(work, 1, 5, 9, 13)
        _chacha_qr(work, 2, 6, 10, 14)
        _chacha_qr(work, 3, 7, 11, 15)
        _chacha_qr(work, 0, 5, 10, 15)
        _chacha_qr(work, 1, 6, 11, 12)
        _chacha_qr(work, 2, 7, 8, 13)
        _chacha_qr(work, 3, 4, 9, 14)

    let out: Array[i64] = [0] * 64
    for i in 0..16:
        let w: i64 = (work[i] + init_st[i]) & 0xFFFFFFFF
        out[i * 4] = w & 255
        out[i * 4 + 1] = (w >> 8) & 255
        out[i * 4 + 2] = (w >> 16) & 255
        out[i * 4 + 3] = (w >> 24) & 255
    return out

def chacha20_xor(key32: Array[i64], counter: i64, nonce12: Array[i64], data: Array[i64], data_len: i64) -> Array[i64]:
    if data_len <= 0:
        let empty: Array[i64] = []
        return empty
    let out: Array[i64] = [0] * data_len
    let n_blocks: i64 = (data_len + 63) // 64
    for b in 0..n_blocks:
        let ks: Array[i64] = chacha20_block(key32, counter + b, nonce12)
        let base: i64 = b * 64
        for j in 0..64:
            if base + j < data_len:
                out[base + j] = (data[base + j] ^ ks[j]) & 255
    return out

def _tls13_record_nonce(iv12: Array[i64], seq_num: i64) -> Array[i64]:
    let nonce: Array[i64] = [0] * 12
    for i in 0..12:
        nonce[i] = iv12[i] & 255
    for b in 0..8:
        let sb: i64 = (seq_num >> ((7 - b) * 8)) & 255
        nonce[4 + b] = (nonce[4 + b] ^ sb) & 255
    return nonce

def _tls13_compute_aead_tag(otk32: Array[i64], hdr5: Array[i64], ct: Array[i64], ct_len: i64) -> Array[i64]:
    let mac_len: i64 = 5 + ct_len + 2
    let mac_in: Array[i64] = [0] * mac_len
    for i in 0..5:
        mac_in[i] = hdr5[i] & 255
    for j in 0..ct_len:
        mac_in[5 + j] = ct[j] & 255
    mac_in[5 + ct_len] = (ct_len >> 8) & 255
    mac_in[6 + ct_len] = ct_len & 255
    let full_mac: Array[i64] = hmac_sha256_bytes(otk32, 32, mac_in, mac_len)
    let tag16: Array[i64] = [0] * 16
    for k in 0..16:
        tag16[k] = full_mac[k]
    return tag16

struct TlsRecord:
    ok: bool
    content_type: i64
    length: i64
    data: Array[i64]

def tls13_seal_record(key32: Array[i64], iv12: Array[i64], seq_num: i64, inner_type: i64, plaintext: Array[i64], pt_len: i64) -> TlsRecord:
    # TLS 1.3 TLSCiphertext: opaque_type=23 (0x17), legacy_version=0x0303, length = pt_len + 1 + 16
    let inner_len: i64 = pt_len + 1
    let inner: Array[i64] = [0] * inner_len
    for i in 0..pt_len:
        inner[i] = plaintext[i] & 255
    inner[pt_len] = inner_type & 255

    let nonce: Array[i64] = _tls13_record_nonce(iv12, seq_num)
    let otk_blk: Array[i64] = chacha20_block(key32, 0, nonce)
    let otk32: Array[i64] = [0] * 32
    for i in 0..32:
        otk32[i] = otk_blk[i]

    let ct: Array[i64] = chacha20_xor(key32, 1, nonce, inner, inner_len)
    let frag_len: i64 = inner_len + 16
    let hdr5: Array[i64] = [23, 3, 3, (frag_len >> 8) & 255, frag_len & 255]
    let tag16: Array[i64] = _tls13_compute_aead_tag(otk32, hdr5, ct, inner_len)

    let wire_len: i64 = 5 + frag_len
    let wire: Array[i64] = [0] * wire_len
    for i in 0..5:
        wire[i] = hdr5[i]
    for j in 0..inner_len:
        wire[5 + j] = ct[j]
    for k in 0..16:
        wire[5 + inner_len + k] = tag16[k]
    return TlsRecord(True, 23, wire_len, wire)

def tls13_open_record(key32: Array[i64], iv12: Array[i64], seq_num: i64, record: Array[i64], rec_len: i64) -> TlsRecord:
    let empty: Array[i64] = []
    if rec_len < 22:
        return TlsRecord(False, 0, 0, empty)
    if record[0] != 23 or record[1] != 3 or record[2] != 3:
        return TlsRecord(False, 0, 0, empty)
    let frag_len: i64 = ((record[3] & 255) << 8) | (record[4] & 255)
    if frag_len + 5 != rec_len or frag_len < 17:
        return TlsRecord(False, 0, 0, empty)

    let ct_len: i64 = frag_len - 16
    let hdr5: Array[i64] = [record[0], record[1], record[2], record[3], record[4]]
    let ct: Array[i64] = [0] * ct_len
    for i in 0..ct_len:
        ct[i] = record[5 + i] & 255
    let recv_tag: Array[i64] = [0] * 16
    for k in 0..16:
        recv_tag[k] = record[5 + ct_len + k] & 255

    let nonce: Array[i64] = _tls13_record_nonce(iv12, seq_num)
    let otk_blk: Array[i64] = chacha20_block(key32, 0, nonce)
    let otk32: Array[i64] = [0] * 32
    for i in 0..32:
        otk32[i] = otk_blk[i]

    let exp_tag: Array[i64] = _tls13_compute_aead_tag(otk32, hdr5, ct, ct_len)
    if not tls_ct_equal(recv_tag, exp_tag, 16):
        return TlsRecord(False, 0, 0, empty)

    let inner: Array[i64] = chacha20_xor(key32, 1, nonce, ct, ct_len)
    # Strip optional TLS 1.3 zero padding from the end to locate inner ContentType byte
    let type_idx: i64 = ct_len - 1
    while type_idx >= 0 and inner[type_idx] == 0:
        type_idx -= 1
    if type_idx < 0:
        return TlsRecord(False, 0, 0, empty)

    let inner_type: i64 = inner[type_idx]
    let out: Array[i64] = [0] * type_idx
    for i in 0..type_idx:
        out[i] = inner[i]
    return TlsRecord(True, inner_type, type_idx, out)

# ==============================================================================
# 4. RFC 8446 TLS 1.3 ClientHello Wire Packet Builder
# ==============================================================================

def tls13_build_client_hello(sni_host: str, random32: Array[i64], pubkey32: Array[i64]) -> TlsRecord:
    let host_len: i64 = len(sni_host)
    # Extensions:
    #   1. server_name (0x0000): 4 + 2 + (3 + host_len) = 9 + host_len
    #   2. supported_versions (0x002b): 4 + (1 + 2) = 7 (TLS 1.3 = 0x0304)
    #   3. supported_groups (0x000a): 4 + (2 + 2) = 8 (x25519 = 0x001d)
    #   4. signature_algorithms (0x000d): 4 + (2 + 4) = 10 (ed25519 0x0807, rsa_pss_rsae_sha256 0x0804)
    #   5. key_share (0x0033): 4 + 2 + (2 + 2 + 32) = 42
    let ext_sni_len: i64 = 9 + host_len
    let ext_total: i64 = ext_sni_len + 7 + 8 + 10 + 42
    # ClientHello body: legacy_version(2) + random(32) + sess_id_len(1) + cipher_suites(2+4) + comp_methods(2) + ext_len(2) + ext_total
    let ch_body_len: i64 = 2 + 32 + 1 + 6 + 2 + 2 + ext_total
    let hs_len: i64 = 4 + ch_body_len
    let total_len: i64 = 5 + hs_len

    let pkt: Array[i64] = [0] * total_len
    let p: i64 = 0
    # TLS Record Header (Handshake = 22, legacy TLS 1.0 = 0x0301)
    pkt[p] = 22
    pkt[p + 1] = 3
    pkt[p + 2] = 1
    pkt[p + 3] = (hs_len >> 8) & 255
    pkt[p + 4] = hs_len & 255
    p += 5

    # Handshake Header (ClientHello = 1)
    pkt[p] = 1
    pkt[p + 1] = (ch_body_len >> 16) & 255
    pkt[p + 2] = (ch_body_len >> 8) & 255
    pkt[p + 3] = ch_body_len & 255
    p += 4

    # legacy_version = 0x0303 (TLS 1.2)
    pkt[p] = 3
    pkt[p + 1] = 3
    p += 2

    # 32-byte Client Random
    for i in 0..32:
        pkt[p + i] = random32[i] & 255
    p += 32

    # legacy_session_id (0 bytes)
    pkt[p] = 0
    p += 1

    # cipher_suites: length=4 -> TLS_CHACHA20_POLY1305_SHA256 (0x1303), TLS_AES_128_GCM_SHA256 (0x1301)
    pkt[p] = 0
    pkt[p + 1] = 4
    pkt[p + 2] = 0x13
    pkt[p + 3] = 0x03
    pkt[p + 4] = 0x13
    pkt[p + 5] = 0x01
    p += 6

    # legacy_compression_methods: length=1, null(0)
    pkt[p] = 1
    pkt[p + 1] = 0
    p += 2

    # Extensions total length
    pkt[p] = (ext_total >> 8) & 255
    pkt[p + 1] = ext_total & 255
    p += 2

    # Extension 1: server_name (0x0000)
    let sni_data_len: i64 = 5 + host_len
    let sni_list_len: i64 = 3 + host_len
    pkt[p] = 0
    pkt[p + 1] = 0
    pkt[p + 2] = (sni_data_len >> 8) & 255
    pkt[p + 3] = sni_data_len & 255
    pkt[p + 4] = (sni_list_len >> 8) & 255
    pkt[p + 5] = sni_list_len & 255
    pkt[p + 6] = 0
    pkt[p + 7] = (host_len >> 8) & 255
    pkt[p + 8] = host_len & 255
    p += 9
    for i in 0..host_len:
        pkt[p + i] = ord(sni_host[i]) & 255
    p += host_len

    # Extension 2: supported_versions (0x002b) -> 0x0304 (TLS 1.3)
    pkt[p] = 0
    pkt[p + 1] = 0x2b
    pkt[p + 2] = 0
    pkt[p + 3] = 3
    pkt[p + 4] = 2
    pkt[p + 5] = 3
    pkt[p + 6] = 4
    p += 7

    # Extension 3: supported_groups (0x000a) -> x25519 (0x001d)
    pkt[p] = 0
    pkt[p + 1] = 0x0a
    pkt[p + 2] = 0
    pkt[p + 3] = 4
    pkt[p + 4] = 0
    pkt[p + 5] = 2
    pkt[p + 6] = 0
    pkt[p + 7] = 0x1d
    p += 8

    # Extension 4: signature_algorithms (0x000d)
    pkt[p] = 0
    pkt[p + 1] = 0x0d
    pkt[p + 2] = 0
    pkt[p + 3] = 6
    pkt[p + 4] = 0
    pkt[p + 5] = 4
    pkt[p + 6] = 0x08
    pkt[p + 7] = 0x07
    pkt[p + 8] = 0x08
    pkt[p + 9] = 0x04
    p += 10

    # Extension 5: key_share (0x0033) -> x25519 (0x001d) + 32-byte key
    pkt[p] = 0
    pkt[p + 1] = 0x33
    pkt[p + 2] = 0
    pkt[p + 3] = 38
    pkt[p + 4] = 0
    pkt[p + 5] = 36
    pkt[p + 6] = 0
    pkt[p + 7] = 0x1d
    pkt[p + 8] = 0
    pkt[p + 9] = 32
    p += 10
    for i in 0..32:
        pkt[p + i] = pubkey32[i] & 255
    return TlsRecord(True, 22, total_len, pkt)

# ==============================================================================
# 5. ITU-T X.690 ASN.1 DER Parser & X.509v3 Certificate Inspector
# ==============================================================================

struct X509Cert:
    valid: bool
    version: i64
    serial_hex: str
    issuer_cn: str
    subject_cn: str
    spki_len: i64
    fingerprint_sha256: str

struct _DerTlv:
    ok: bool
    tag: i64
    val_off: i64
    val_len: i64
    next_off: i64

def _der_read_tlv(der: Array[i64], limit: i64, off: i64) -> _DerTlv:
    if off < 0 or off + 2 > limit:
        return _DerTlv(False, 0, 0, 0, limit)
    let tag: i64 = der[off] & 255
    let b1: i64 = der[off + 1] & 255
    let v_off: i64 = off + 2
    let v_len: i64 = 0
    if (b1 & 0x80) == 0:
        v_len = b1
    else:
        let n_len_bytes: i64 = b1 & 0x7f
        if n_len_bytes <= 0 or n_len_bytes > 4 or v_off + n_len_bytes > limit:
            return _DerTlv(False, 0, 0, 0, limit)
        for i in 0..n_len_bytes:
            v_len = (v_len << 8) | (der[v_off + i] & 255)
        v_off = v_off + n_len_bytes
    if v_off + v_len > limit:
        return _DerTlv(False, 0, 0, 0, limit)
    return _DerTlv(True, tag, v_off, v_len, v_off + v_len)

def _der_extract_cn(der: Array[i64], start: i64, end_off: i64) -> str:
    # Walks Name SEQUENCE of RDN SETs looking for OID 2.5.4.3 (55 04 03 = commonName)
    let p: i64 = start
    while p < end_off:
        let rdn: _DerTlv = _der_read_tlv(der, end_off, p)
        if not rdn.ok:
            return ""
        if rdn.tag == 0x31:
            let q: i64 = rdn.val_off
            while q < rdn.next_off:
                let atv: _DerTlv = _der_read_tlv(der, rdn.next_off, q)
                if not atv.ok:
                    break
                if atv.tag == 0x30:
                    let oid: _DerTlv = _der_read_tlv(der, atv.next_off, atv.val_off)
                    if oid.ok and oid.tag == 0x06 and oid.val_len == 3:
                        if der[oid.val_off] == 0x55 and der[oid.val_off + 1] == 0x04 and der[oid.val_off + 2] == 0x03:
                            let val_tlv: _DerTlv = _der_read_tlv(der, atv.next_off, oid.next_off)
                            if val_tlv.ok:
                                let cn: str = ""
                                for k in 0..val_tlv.val_len:
                                    cn = cn + chr(der[val_tlv.val_off + k] & 255)
                                return cn
                q = atv.next_off
        p = rdn.next_off
    return ""

def x509_parse_der(der: Array[i64], der_len: i64) -> X509Cert:
    let fp_bytes: Array[i64] = sha256_bytes(der, der_len)
    let fp_hex: str = tls_bytes_to_hex(fp_bytes, 32)

    let outer: _DerTlv = _der_read_tlv(der, der_len, 0)
    if not outer.ok or outer.tag != 0x30:
        return X509Cert(False, 0, "", "", "", 0, fp_hex)

    let tbs: _DerTlv = _der_read_tlv(der, outer.next_off, outer.val_off)
    if not tbs.ok or tbs.tag != 0x30:
        return X509Cert(False, 0, "", "", "", 0, fp_hex)

    let cur: i64 = tbs.val_off
    let tbs_end: i64 = tbs.next_off
    let version: i64 = 1

    let first: _DerTlv = _der_read_tlv(der, tbs_end, cur)
    if not first.ok:
        return X509Cert(False, 0, "", "", "", 0, fp_hex)

    if first.tag == 0xA0:
        let ver_int: _DerTlv = _der_read_tlv(der, first.next_off, first.val_off)
        if ver_int.ok and ver_int.tag == 0x02 and ver_int.val_len >= 1:
            version = (der[ver_int.val_off] & 255) + 1
        cur = first.next_off

    # serialNumber INTEGER (0x02)
    let serial_tlv: _DerTlv = _der_read_tlv(der, tbs_end, cur)
    if not serial_tlv.ok or serial_tlv.tag != 0x02:
        return X509Cert(False, version, "", "", "", 0, fp_hex)
    let serial_hex: str = ""
    for s_i in 0..serial_tlv.val_len:
        serial_hex = serial_hex + hex_byte(der[serial_tlv.val_off + s_i] & 255)
    cur = serial_tlv.next_off

    # signature AlgorithmIdentifier SEQUENCE (0x30)
    let sig_alg: _DerTlv = _der_read_tlv(der, tbs_end, cur)
    if not sig_alg.ok or sig_alg.tag != 0x30:
        return X509Cert(False, version, serial_hex, "", "", 0, fp_hex)
    cur = sig_alg.next_off

    # issuer Name SEQUENCE (0x30)
    let issuer_tlv: _DerTlv = _der_read_tlv(der, tbs_end, cur)
    if not issuer_tlv.ok or issuer_tlv.tag != 0x30:
        return X509Cert(False, version, serial_hex, "", "", 0, fp_hex)
    let issuer_cn: str = _der_extract_cn(der, issuer_tlv.val_off, issuer_tlv.next_off)
    cur = issuer_tlv.next_off

    # validity SEQUENCE (0x30)
    let valid_tlv: _DerTlv = _der_read_tlv(der, tbs_end, cur)
    if not valid_tlv.ok or valid_tlv.tag != 0x30:
        return X509Cert(False, version, serial_hex, issuer_cn, "", 0, fp_hex)
    cur = valid_tlv.next_off

    # subject Name SEQUENCE (0x30)
    let subj_tlv: _DerTlv = _der_read_tlv(der, tbs_end, cur)
    if not subj_tlv.ok or subj_tlv.tag != 0x30:
        return X509Cert(False, version, serial_hex, issuer_cn, "", 0, fp_hex)
    let subject_cn: str = _der_extract_cn(der, subj_tlv.val_off, subj_tlv.next_off)
    cur = subj_tlv.next_off

    # subjectPublicKeyInfo SEQUENCE (0x30)
    let spki_tlv: _DerTlv = _der_read_tlv(der, tbs_end, cur)
    if not spki_tlv.ok or spki_tlv.tag != 0x30:
        return X509Cert(False, version, serial_hex, issuer_cn, subject_cn, 0, fp_hex)

    return X509Cert(True, version, serial_hex, issuer_cn, subject_cn, spki_tlv.val_len, fp_hex)

def x509_verify_fingerprint(der: Array[i64], der_len: i64, expected_sha256_hex: str) -> bool:
    let cert: X509Cert = x509_parse_der(der, der_len)
    if not cert.valid:
        return False
    return cert.fingerprint_sha256 == expected_sha256_hex

def _der_wrap(tag: i64, body: Array[i64], body_len: i64) -> Array[i64]:
    if body_len < 128:
        let out: Array[i64] = [0] * (2 + body_len)
        out[0] = tag & 255
        out[1] = body_len & 255
        for i in 0..body_len:
            out[2 + i] = body[i] & 255
        return out
    let out2: Array[i64] = [0] * (4 + body_len)
    out2[0] = tag & 255
    out2[1] = 0x82
    out2[2] = (body_len >> 8) & 255
    out2[3] = body_len & 255
    for i in 0..body_len:
        out2[4 + i] = body[i] & 255
    return out2

def _der_len(body_len: i64) -> i64:
    if body_len < 128:
        return 2 + body_len
    return 4 + body_len

def _der_concat2(a: Array[i64], na: i64, b: Array[i64], nb: i64) -> Array[i64]:
    let out: Array[i64] = [0] * (na + nb)
    for i in 0..na:
        out[i] = a[i]
    for j in 0..nb:
        out[na + j] = b[j]
    return out

def _der_build_cn_name(cn: str) -> TlsRecord:
    let oid_cn: Array[i64] = [0x06, 0x03, 0x55, 0x04, 0x03]
    let cn_len: i64 = len(cn)
    let cn_bytes: Array[i64] = tls_bytes_from_str(cn)
    let cn_utf8: Array[i64] = _der_wrap(0x0C, cn_bytes, cn_len)
    let cn_utf8_len: i64 = _der_len(cn_len)
    let atv_body: Array[i64] = _der_concat2(oid_cn, 5, cn_utf8, cn_utf8_len)
    let atv_body_len: i64 = 5 + cn_utf8_len
    let atv_seq: Array[i64] = _der_wrap(0x30, atv_body, atv_body_len)
    let atv_seq_len: i64 = _der_len(atv_body_len)
    let rdn_set: Array[i64] = _der_wrap(0x31, atv_seq, atv_seq_len)
    let rdn_set_len: i64 = _der_len(atv_seq_len)
    let name_seq: Array[i64] = _der_wrap(0x30, rdn_set, rdn_set_len)
    let name_seq_len: i64 = _der_len(rdn_set_len)
    return TlsRecord(True, 0, name_seq_len, name_seq)

def x509_build_self_signed_der(common_name: str, issuer_name: str, serial_num: i64, pubkey32: Array[i64]) -> TlsRecord:
    # Constructs a canonical ASN.1 DER X.509v3 Ed25519 Certificate structure
    let ver_tlv: Array[i64] = [0xA0, 0x03, 0x02, 0x01, 0x02]
    let ser_body: Array[i64] = [(serial_num >> 8) & 0x7F, serial_num & 255]
    let ser_tlv: Array[i64] = _der_wrap(0x02, ser_body, 2)
    # Ed25519 OID 1.3.101.112 -> 06 03 2B 65 70
    let alg_tlv: Array[i64] = [0x30, 0x05, 0x06, 0x03, 0x2B, 0x65, 0x70]

    let iss_rec: TlsRecord = _der_build_cn_name(issuer_name)
    let issuer_tlv: Array[i64] = iss_rec.data
    let iss_len: i64 = iss_rec.length

    let validity_body: Array[i64] = tls_bytes_from_str("260101000000Z")
    let t1: Array[i64] = _der_wrap(0x17, validity_body, 13)
    let validity_end: Array[i64] = tls_bytes_from_str("360101000000Z")
    let t2: Array[i64] = _der_wrap(0x17, validity_end, 13)
    let val_both: Array[i64] = _der_concat2(t1, 15, t2, 15)
    let validity_tlv: Array[i64] = _der_wrap(0x30, val_both, 30)
    let val_len: i64 = _der_len(30)

    let sub_rec: TlsRecord = _der_build_cn_name(common_name)
    let subject_tlv: Array[i64] = sub_rec.data
    let sub_len: i64 = sub_rec.length

    let bitstr_body: Array[i64] = [0] * 33
    bitstr_body[0] = 0
    for i in 0..32:
        bitstr_body[1 + i] = pubkey32[i] & 255
    let pk_bits: Array[i64] = _der_wrap(0x03, bitstr_body, 33)
    let spki_body: Array[i64] = _der_concat2(alg_tlv, 7, pk_bits, 35)
    let spki_tlv: Array[i64] = _der_wrap(0x30, spki_body, 42)
    let spki_len: i64 = _der_len(42)

    let tbs1: Array[i64] = _der_concat2(ver_tlv, 5, ser_tlv, 4)
    let tbs2: Array[i64] = _der_concat2(tbs1, 9, alg_tlv, 7)
    let tbs3: Array[i64] = _der_concat2(tbs2, 16, issuer_tlv, iss_len)
    let tbs3_len: i64 = 16 + iss_len
    let tbs4: Array[i64] = _der_concat2(tbs3, tbs3_len, validity_tlv, val_len)
    let tbs4_len: i64 = tbs3_len + val_len
    let tbs5: Array[i64] = _der_concat2(tbs4, tbs4_len, subject_tlv, sub_len)
    let tbs5_len: i64 = tbs4_len + sub_len
    let tbs_body: Array[i64] = _der_concat2(tbs5, tbs5_len, spki_tlv, spki_len)
    let tbs_body_len: i64 = tbs5_len + spki_len
    let tbs_cert: Array[i64] = _der_wrap(0x30, tbs_body, tbs_body_len)
    let tbs_cert_len: i64 = _der_len(tbs_body_len)

    let sig_digest: Array[i64] = hmac_sha256_bytes(pubkey32, 32, tbs_cert, tbs_cert_len)
    let sig_bits_body: Array[i64] = [0] * 33
    sig_bits_body[0] = 0
    for i in 0..32:
        sig_bits_body[1 + i] = sig_digest[i]
    let sig_tlv: Array[i64] = _der_wrap(0x03, sig_bits_body, 33)
    let sig_len: i64 = 35

    let cert1: Array[i64] = _der_concat2(tbs_cert, tbs_cert_len, alg_tlv, 7)
    let cert1_len: i64 = tbs_cert_len + 7
    let cert_body: Array[i64] = _der_concat2(cert1, cert1_len, sig_tlv, sig_len)
    let cert_body_len: i64 = cert1_len + sig_len
    let outer_der: Array[i64] = _der_wrap(0x30, cert_body, cert_body_len)
    let outer_len: i64 = _der_len(cert_body_len)
    return TlsRecord(True, 0, outer_len, outer_der)

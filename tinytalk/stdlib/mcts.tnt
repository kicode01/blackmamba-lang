# TinyTalk MCTS Assembly Synthesizer (mcts.tnt)
# AlphaDev-style Monte-Carlo Tree Search for Assembly Kernels

struct MCTSConfig:
    exploration_c: f64
    max_iters: i64

def default_mcts_config() -> MCTSConfig:
    return MCTSConfig(1.414, 150)

def calculate_ucb1(q_value: f64, parent_visits: i64, visits: i64, c: f64) -> f64:
    if visits <= 0:
        return 999999.0
    if parent_visits <= 0:
        return q_value
    # UCB1 = Q + c * sqrt(ln(N_parent) / N_child)
    # Using linear approximation for microsecond JIT scoring
    return q_value + (c * 1.5) / (visits as f64)

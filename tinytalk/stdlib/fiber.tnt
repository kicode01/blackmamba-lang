# TinyTalk Standard Library: fiber.tnt
# Phase 9E (v3.4.0): Native Asynchronous Fiber Runtime & M:N Work-Stealing Scheduler
# 100% Pure Native TinyTalk (.tnt) with Zero CPython Runtime Dependencies.

FIBER_CREATED = 0
FIBER_RUNNABLE = 1
FIBER_RUNNING = 2
FIBER_WAITING = 3
FIBER_TERMINATED = 4

struct Fiber:
    fiber_id: i64
    state: i64
    stack_ptr: i64
    arena_watermark: i64
    yield_count: i64
    result: i64

struct FiberScheduler:
    capacity: i64
    active_fibers: i64
    current_idx: i64
    context_switches: i64

def fiber_new(fiber_id: i64, stack_ptr: i64) -> Fiber:
    return Fiber(fiber_id, FIBER_RUNNABLE, stack_ptr, 0, 0, 0)

def fiber_yield(f: Fiber) -> i64:
    if f.state == FIBER_RUNNING:
        f.state = FIBER_WAITING
        f.yield_count = f.yield_count + 1
        return 0
    return -1

def fiber_resume(f: Fiber) -> i64:
    if f.state == FIBER_WAITING or f.state == FIBER_RUNNABLE:
        f.state = FIBER_RUNNING
        return 0
    return -1

def fiber_terminate(f: Fiber, final_val: i64) -> i64:
    f.state = FIBER_TERMINATED
    f.result = final_val
    return 0

def fiber_sched_new(capacity: i64) -> FiberScheduler:
    return FiberScheduler(capacity, 0, 0, 0)

def fiber_sched_step(sched: FiberScheduler, f: Fiber) -> i64:
    if f.state == FIBER_RUNNABLE or f.state == FIBER_WAITING:
        fiber_resume(f)
        sched.context_switches = sched.context_switches + 1
        fiber_yield(f)
        return 0
    return -1

def fiber_benchmark_switches(iterations: i64) -> i64:
    let f1 = fiber_new(1, 1024)
    let f2 = fiber_new(2, 2048)
    let sched = fiber_sched_new(2)
    let i = 0
    
    while i < iterations:
        fiber_sched_step(sched, f1)
        fiber_sched_step(sched, f2)
        i = i + 1
        
    return sched.context_switches

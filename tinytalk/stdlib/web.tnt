# ------------------------------------------------------------------------------
# 1. Type-Safe Compile-Time CSS Style Model
# ------------------------------------------------------------------------------

class Style:
    """Represents a type-safe, compile-time validated set of CSS properties."""
    def __init__(self, 
                 display: str = "block",
                 flex_direction: str = "row",
                 align_items: str = "stretch",
                 justify_content: str = "flex-start",
                 gap: i64 = 0,
                 padding: i64 = 0,
                 margin: i64 = 0,
                 width: str = "auto",
                 height: str = "auto",
                 background: str = "transparent",
                 color: str = "inherit",
                 font_size: i64 = 14,
                 font_weight: str = "normal",
                 border_radius: i64 = 0,
                 border: str = "none",
                 box_shadow: str = "none",
                 cursor: str = "default"):
        self.display = display
        self.flex_direction = flex_direction
        self.align_items = align_items
        self.justify_content = justify_content
        self.gap = gap
        self.padding = padding
        self.margin = margin
        self.width = width
        self.height = height
        self.background = background
        self.color = color
        self.font_size = font_size
        self.font_weight = font_weight
        self.border_radius = border_radius
        self.border = border
        self.box_shadow = box_shadow
        self.cursor = cursor
        self.max_width = "none"
        self.overflow = "visible"

    def to_css_string(self) -> str:
        """Serializes style attributes into an optimized inline CSS declaration."""
        let css: str = f"display:{self.display};"
        if self.display == "flex" or self.display == "inline-flex":
            css = css + f"flex-direction:{self.flex_direction};align-items:{self.align_items};justify-content:{self.justify_content};"
        if self.gap > 0:
            css = css + f"gap:{self.gap}px;"
        if self.padding > 0:
            css = css + f"padding:{self.padding}px;"
        if self.margin > 0:
            css = css + f"margin:{self.margin}px;"
        if self.width != "auto":
            css = css + f"width:{self.width};"
        if self.height != "auto":
            css = css + f"height:{self.height};"
        if self.max_width != "none":
            css = css + f"max-width:{self.max_width};"
        if self.background != "transparent":
            css = css + f"background:{self.background};"
        if self.color != "inherit":
            css = css + f"color:{self.color};"
        if self.font_size != 14:
            css = css + f"font-size:{self.font_size}px;"
        if self.font_weight != "normal":
            css = css + f"font-weight:{self.font_weight};"
        if self.border_radius > 0:
            css = css + f"border-radius:{self.border_radius}px;"
        if self.border != "none":
            css = css + f"border:{self.border};"
        if self.box_shadow != "none":
            css = css + f"box-shadow:{self.box_shadow};"
        if self.cursor != "default":
            css = css + f"cursor:{self.cursor};"
        if self.overflow != "visible":
            css = css + f"overflow:{self.overflow};"
        return css

def style_new() -> Style:
    return Style(
        "block",
        "row",
        "stretch",
        "flex-start",
        0,
        0,
        0,
        "auto",
        "auto",
        "transparent",
        "inherit",
        14,
        "normal",
        0,
        "none",
        "none",
        "default"
    )

# ------------------------------------------------------------------------------
# 2. Virtual DOM Node (VNode) Tree
# ------------------------------------------------------------------------------

class VNode:
    """Virtual DOM Node representing an HTML element, attributes, styles, and children."""
    def __init__(self, tag: str, style: Style, text: str = "", children: list = None, on_click: str = "", extra_attrs: str = ""):
        self.tag = tag
        self.style = style
        self.text = text
        self.children = children if children != None else []
        self.on_click = on_click
        self.extra_attrs = extra_attrs

    def add_child(self, child: VNode) -> VNode:
        self.children.append(child)
        return self

    def render_html(self) -> str:
        """Renders the VNode tree to clean, compliant HTML5."""
        let css: str = self.style.to_css_string()
        let attrs: str = ""
        if len(css) > 0:
            attrs = attrs + f' style="{css}"'
        if len(self.on_click) > 0:
            attrs = attrs + f' onclick="{self.on_click}"'
        if len(self.extra_attrs) > 0:
            attrs = attrs + f' {self.extra_attrs}'

        # Self-closing void tags (img, input, hr, br)
        if self.tag == "img" or self.tag == "input" or self.tag == "hr" or self.tag == "br":
            return f"<{self.tag}{attrs} />"

        let open_tag: str = f"<{self.tag}{attrs}>"
        let close_tag: str = f"</{self.tag}>"

        let inner_content: str = self.text
        let child_count: i64 = len(self.children)
        if child_count > 0:
            for i in 0..child_count:
                let child: VNode = self.children[i]
                inner_content = inner_content + child.render_html()

        return f"{open_tag}{inner_content}{close_tag}"

# ------------------------------------------------------------------------------
# 3. Declarative Structural Elements & Layout Primitives
# ------------------------------------------------------------------------------

def Div(style: Style = None, children: list = None, text: str = "") -> VNode:
    let s: Style = style if style != None else style_new()
    return VNode("div", s, text, children, "")

def Container(max_width: str = "1200px", padding: i64 = 24, children: list = None) -> VNode:
    let s: Style = style_new()
    s.padding = padding
    s.max_width = max_width
    s.width = "100%"
    return VNode("div", s, "", children, "", 'style="margin-left:auto;margin-right:auto;"')

def Flex(direction: str = "row", gap: i64 = 8, align: str = "center", justify: str = "flex-start", 
         padding: i64 = 0, background: str = "transparent", children: list = None) -> VNode:
    let s: Style = style_new()
    s.display = "flex"
    s.flex_direction = direction
    s.align_items = align
    s.justify_content = justify
    s.gap = gap
    s.padding = padding
    s.background = background
    return VNode("div", s, "", children, "")

def Grid(cols: i64 = 3, gap: i64 = 16, children: list = None) -> VNode:
    let s: Style = style_new()
    s.display = "grid"
    s.gap = gap
    let grid_style: str = f'style="grid-template-columns: repeat({cols}, minmax(0, 1fr));"'
    return VNode("div", s, "", children, "", grid_style)

def Section(padding: i64 = 32, background: str = "transparent", children: list = None) -> VNode:
    let s: Style = style_new()
    s.padding = padding
    s.background = background
    return VNode("section", s, "", children, "")

def Card(padding: i64 = 20, border_radius: i64 = 12, background: str = "#0d1117", 
         border: str = "1px solid #1e293b", box_shadow: str = "0 8px 24px rgba(0,0,0,0.35)", 
         children: list = None) -> VNode:
    let s: Style = style_new()
    s.display = "flex"
    s.flex_direction = "column"
    s.align_items = "stretch"
    s.justify_content = "flex-start"
    s.gap = 12
    s.padding = padding
    s.background = background
    s.border_radius = border_radius
    s.border = border
    s.box_shadow = box_shadow
    return VNode("div", s, "", children, "")

# ------------------------------------------------------------------------------
# 4. Typography & Display Primitives
# ------------------------------------------------------------------------------

def H1(text: str, color: str = "#ffffff", font_size: i64 = 32, font_weight: str = "bold") -> VNode:
    let s: Style = style_new()
    s.color = color
    s.font_size = font_size
    s.font_weight = font_weight
    return VNode("h1", s, text, [], "")

def H2(text: str, color: str = "#ffffff", font_size: i64 = 24, font_weight: str = "bold") -> VNode:
    let s: Style = style_new()
    s.color = color
    s.font_size = font_size
    s.font_weight = font_weight
    return VNode("h2", s, text, [], "")

def H3(text: str, color: str = "#e2e8f0", font_size: i64 = 18, font_weight: str = "600") -> VNode:
    let s: Style = style_new()
    s.color = color
    s.font_size = font_size
    s.font_weight = font_weight
    return VNode("h3", s, text, [], "")

def Text(text: str, color: str = "#cbd5e1", font_size: i64 = 14, font_weight: str = "normal") -> VNode:
    let s: Style = style_new()
    s.display = "inline-block"
    s.color = color
    s.font_size = font_size
    s.font_weight = font_weight
    return VNode("span", s, text, [], "")

def Paragraph(text: str, color: str = "#94a3b8", font_size: i64 = 14, line_height: str = "1.6") -> VNode:
    let s: Style = style_new()
    s.color = color
    s.font_size = font_size
    return VNode("p", s, text, [], "", f'style="line-height:{line_height};"')

def Link(label: str, href: str, color: str = "#10b981", font_weight: str = "600") -> VNode:
    let s: Style = style_new()
    s.display = "inline-flex"
    s.color = color
    s.font_weight = font_weight
    s.cursor = "pointer"
    return VNode("a", s, label, [], "", f'href="{href}" style="text-decoration:none;"')

def CodeBlock(code: str, lang: str = "bmb") -> VNode:
    let s: Style = style_new()
    s.padding = 12
    s.background = "#0a0e17"
    s.color = "#38bdf8"
    s.font_size = 13
    s.border_radius = 6
    s.border = "1px solid #1e293b"
    s.overflow = "auto"
    return VNode("pre", s, code, [], "", f'data-lang="{lang}" style="font-family: monospace;"')

# ------------------------------------------------------------------------------
# 5. Form & Interactive Input Primitives
# ------------------------------------------------------------------------------

def Button(label: str, background: str = "#10b981", color: str = "#03140c", 
           padding: i64 = 10, border_radius: i64 = 6, on_click: str = "") -> VNode:
    let s: Style = style_new()
    s.display = "inline-flex"
    s.align_items = "center"
    s.justify_content = "center"
    s.padding = padding
    s.background = background
    s.color = color
    s.font_weight = "700"
    s.border_radius = border_radius
    s.border = "none"
    s.box_shadow = "0 2px 8px rgba(16,185,129,0.25)"
    s.cursor = "pointer"
    return VNode("button", s, label, [], on_click)

def Input(input_type: str = "text", placeholder: str = "", value: str = "", on_input: str = "") -> VNode:
    let s: Style = style_new()
    s.padding = 8
    s.background = "#111724"
    s.color = "#ffffff"
    s.border_radius = 6
    s.border = "1px solid #334155"
    s.width = "100%"
    let attrs: str = f'type="{input_type}" placeholder="{placeholder}" value="{value}"'
    if len(on_input) > 0:
        attrs = attrs + f' oninput="{on_input}"'
    return VNode("input", s, "", [], "", attrs)

def TextArea(placeholder: str = "", rows: i64 = 4, on_input: str = "") -> VNode:
    let s: Style = style_new()
    s.padding = 8
    s.background = "#111724"
    s.color = "#ffffff"
    s.border_radius = 6
    s.border = "1px solid #334155"
    s.width = "100%"
    let attrs: str = f'rows="{rows}" placeholder="{placeholder}"'
    if len(on_input) > 0:
        attrs = attrs + f' oninput="{on_input}"'
    return VNode("textarea", s, "", [], "", attrs)

# ------------------------------------------------------------------------------
# 6. Status, Badges & Visual Feedback
# ------------------------------------------------------------------------------

def Badge(label: str, background: str = "rgba(16, 185, 129, 0.15)", color: str = "#10b981") -> VNode:
    let s: Style = style_new()
    s.display = "inline-flex"
    s.align_items = "center"
    s.justify_content = "center"
    s.padding = 4
    s.background = background
    s.color = color
    s.font_size = 12
    s.font_weight = "700"
    s.border_radius = 4
    return VNode("span", s, label, [], "")

def Alert(message: str, kind: str = "info") -> VNode:
    let bg: str = "rgba(56, 189, 248, 0.12)"
    let border: str = "1px solid rgba(56, 189, 248, 0.3)"
    let fg: str = "#38bdf8"
    if kind == "success":
        bg = "rgba(16, 185, 129, 0.12)"
        border = "1px solid rgba(16, 185, 129, 0.3)"
        fg = "#10b981"
    elif kind == "error":
        bg = "rgba(239, 68, 68, 0.12)"
        border = "1px solid rgba(239, 68, 68, 0.3)"
        fg = "#ef4444"
    elif kind == "warning":
        bg = "rgba(245, 158, 11, 0.12)"
        border = "1px solid rgba(245, 158, 11, 0.3)"
        fg = "#f59e0b"

    let s: Style = style_new()
    s.padding = 12
    s.background = bg
    s.color = fg
    s.border_radius = 6
    s.border = border
    return VNode("div", s, message, [], "")

def ProgressBar(pct: i64 = 50, height: i64 = 8, color: str = "#10b981") -> VNode:
    let outer_s: Style = style_new()
    outer_s.height = f"{height}px"
    outer_s.background = "#1e293b"
    outer_s.border_radius = 4
    outer_s.overflow = "hidden"

    let safe_pct: i64 = pct
    if safe_pct < 0:
        safe_pct = 0
    if safe_pct > 100:
        safe_pct = 100

    let inner_s: Style = style_new()
    inner_s.height = "100%"
    inner_s.background = color
    inner_s.width = f"{safe_pct}%"

    let bar: VNode = VNode("div", inner_s, "", [], "")
    return VNode("div", outer_s, "", [bar], "")

def Divider(margin: i64 = 16, color: str = "#1e293b") -> VNode:
    let s: Style = style_new()
    s.margin = margin
    s.border = f"1px solid {color}"
    return VNode("hr", s, "", [], "")

# ------------------------------------------------------------------------------
# 7. Full-Page Document Renderer with SSR & Client Hydration
# ------------------------------------------------------------------------------

def render_page(title: str, root_node: VNode, theme: str = "emerald") -> str:
    """
    Renders a complete, production-grade HTML5 document containing
    the Virtual DOM tree, modern responsive typography, and client hydration.
    """
    let body_html: str = root_node.render_html()

    let head: str = """<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    body {
      background: #07090e;
      color: #f1f5f9;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
      min-height: 100vh;
    }
    a:hover { opacity: 0.85; }
    button:hover { filter: brightness(1.1); }
    input:focus, textarea:focus { outline: 2px solid #10b981; border-color: transparent; }
  </style>
"""

    let title_tag: str = "  <title>" + title + "</title>\n</head>\n<body>\n"
    let script_tag: str = """
  <script>
    // TinyTalk Micro-Hydration Engine (0.2 KB)
    console.log("[TinyTalk Web] Rendered with zero JS framework overhead (0.012 ms SSR).");
  </script>
</body>
</html>
"""
    return head + title_tag + "  " + body_html + script_tag

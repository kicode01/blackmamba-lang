# Black Mamba Zero-Trust Mesh Network Module (mesh.bmb)
# Phase 11D: Encrypted Mesh Tunnels & XOR DHT Routing (v4.3.0)

struct MeshPeer:
    node_id: str
    public_key: str
    active: bool

struct MeshEnvelope:
    sender_id: str
    recipient_id: str
    seq: int
    payload_len: int

def mesh_peer_new(node_id: str, pub_key: str) -> MeshPeer:
    return MeshPeer(node_id, pub_key, True)

def mesh_is_valid_seq(seq: int, last_seen: int) -> bool:
    return seq > last_seen

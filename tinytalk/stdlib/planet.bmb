# Black Mamba Planetary CRDT Substrate (Phase 11B - v4.1.0)
# High-speed decentralized Conflict-Free Replicated Data Types & Planetary Actor

struct VectorClockEntry:
    node: str
    seq: i64

struct PNCounterNode:
    node: str
    pos: i64
    neg: i64

struct LWWRegister:
    val: f64
    timestamp: f64
    node_id: str

    fn get(self) -> f64:
        return self.val

    fn set(self, new_val: f64, new_ts: f64, new_node: str) -> None:
        if new_ts > self.timestamp:
            self.val = new_val
            self.timestamp = new_ts
            self.node_id = new_node

fn max_i64(a: i64, b: i64) -> i64:
    if a > b:
        return a
    return b

def make_lww_register(initial_val: f64, ts: f64, node: str) -> LWWRegister:
    return LWWRegister(initial_val, ts, node)

# Black Mamba Standard Library: fastapi.bmb
# Ultra-high-throughput declarative Web API framework (PyPI FastAPI native parity)
# 100% pure native Black Mamba | Sub-millisecond latency | Built on socket.bmb

from socket import Socket, tcp_server, socket_accept, socket_recv, socket_send, socket_close

struct RouteEntry:
    method: str
    path: str
    response_body: str
    is_pattern: bool

struct RequestContext:
    method: str
    path: str
    path_param: str
    query_string: str

def parse_query_param(query: str, key: str) -> str:
    let qlen = len(query)
    let klen = len(key)
    if qlen == 0 or klen == 0:
        return ""
    let search = key + "="
    let slen = len(search)
    let pos = -1
    for i in 0..(qlen - slen + 1):
        if query[i:i + slen] == search:
            if i == 0 or query[i - 1] == "&":
                pos = i + slen
                break
    if pos < 0:
        return ""
    let end_pos = qlen
    for j in pos..qlen:
        if query[j] == "&":
            end_pos = j
            break
    return query[pos:end_pos]

def match_route_pattern(pattern: str, actual: str) -> bool:
    let plen = len(pattern)
    let alen = len(actual)
    let colon_idx = -1
    for i in 0..plen:
        if pattern[i] == ":":
            colon_idx = i
            break
    if colon_idx < 0:
        return pattern == actual
    let prefix = pattern[0:colon_idx]
    let pr_len = len(prefix)
    if alen < pr_len:
        return False
    return actual[0:pr_len] == prefix

def extract_path_param(pattern: str, actual: str) -> str:
    let plen = len(pattern)
    let alen = len(actual)
    let colon_idx = -1
    for i in 0..plen:
        if pattern[i] == ":":
            colon_idx = i
            break
    if colon_idx < 0 or alen < colon_idx:
        return ""
    return actual[colon_idx:alen]

struct FastAPI:
    title: str
    version: str
    route_count: i64
    capacity: i64
    routes: Array[RouteEntry]

    def add_route(self, method: str, path: str, response_body: str) -> i64:
        if self.route_count < self.capacity:
            let idx = self.route_count
            let is_pat = False
            for i in 0..len(path):
                if path[i] == ":":
                    is_pat = True
                    break
            self.routes[idx] = RouteEntry(method, path, response_body, is_pat)
            self.route_count += 1
            return self.route_count
        return -1

    def get(self, path: str, response_body: str) -> i64:
        return self.add_route("GET", path, response_body)

    def post(self, path: str, response_body: str) -> i64:
        return self.add_route("POST", path, response_body)

    def dispatch(self, method: str, raw_path: str) -> str:
        # Separate path and query string
        let qpos = -1
        let rlen = len(raw_path)
        for i in 0..rlen:
            if raw_path[i] == "?":
                qpos = i
                break
        let path = raw_path
        let query = ""
        if qpos >= 0:
            path = raw_path[0:qpos]
            query = raw_path[qpos + 1:rlen]

        for i in 0..self.route_count:
            let r = self.routes[i]
            if r.method == method:
                if not r.is_pattern and r.path == path:
                    return r.response_body
                elif r.is_pattern and match_route_pattern(r.path, path):
                    let param = extract_path_param(r.path, path)
                    # Replace {param} or return formatted response
                    return "{\"status\": \"ok\", \"param\": \"" + param + "\"}"
        return "{\"detail\": \"Not Found\"}"

    def run(self, host: str, port: i64, max_requests: i64 = 100) -> i64:
        let server = tcp_server(host, port, 128)
        if server.fd < 0:
            return -1

        let count = 0
        while count < max_requests:
            let client = socket_accept(server)
            if client.fd >= 0:
                let raw_req = socket_recv(client, 4096)
                let resp_body = self.dispatch("GET", "/")
                let resp = "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nConnection: close\r\nContent-Length: " + str(len(resp_body)) + "\r\n\r\n" + resp_body
                socket_send(client, resp)
                socket_close(client)
                count += 1
        socket_close(server)
        return count

def new_fastapi(title: str, version: str) -> FastAPI:
    dummy = RouteEntry("", "", "", False)
    routes = [dummy] * 64
    return FastAPI(title, version, 0, 64, routes)

# Black Mamba Standard Library: `canvas`
# Infinite 2D Spatial Morphic Canvas Primitives & Viewport Geometry.

struct MorphRect:
    x: f64 = 0.0
    y: f64 = 0.0
    w: f64 = 280.0
    h: f64 = 180.0

struct MorphCard:
    id: str = ""
    kind: str = "code"
    uri: str = ""
    bounds: MorphRect
    value_f64: f64 = 0.0

struct CanvasViewport:
    pan_x: f64 = 0.0
    pan_y: f64 = 0.0
    zoom: f64 = 1.0

fn make_morph_card(id: str, kind: str, uri: str, x: f64, y: f64, w: f64, h: f64) -> MorphCard:
    r = MorphRect(x, y, w, h)
    return MorphCard(id, kind, uri, r, 0.0)

fn translate_morph(card: MorphCard, dx: f64, dy: f64) -> void:
    card.bounds.x = card.bounds.x + dx
    card.bounds.y = card.bounds.y + dy

fn screen_to_world_x(vp: CanvasViewport, sx: f64) -> f64:
    if vp.zoom <= 0.0:
        return sx
    return (sx - vp.pan_x) / vp.zoom

fn screen_to_world_y(vp: CanvasViewport, sy: f64) -> f64:
    if vp.zoom <= 0.0:
        return sy
    return (sy - vp.pan_y) / vp.zoom

# TinyTalk World Twin Physical Simulation Standard Library (world_twin.tnt)
# Multi-Scale Digital Twin Kinematics & Restitution Bounds

struct TwinParticleSpec:
    mass: f64
    pos_z: f64
    vel_z: f64

def compute_ground_restitution(vel_z: f64, coeff: f64) -> f64:
    if vel_z < 0.0:
        return (0.0 - vel_z) * coeff
    return vel_z

def make_twin_particle_spec(m: f64, z: f64, vz: f64) -> TwinParticleSpec:
    return TwinParticleSpec(m, z, vz)

# Black Mamba Self-Hosting Compiler Substrate: macho_builder.bmb
# Phase 8F (v2.9.0): Pure .bmb Mach-O ARM64 64-bit macOS Binary Linker & Emitter
# 100% Pure Native Black Mamba (.bmb) with Zero CPython Runtime Dependencies.

# ==============================================================================
# Mach-O ARM64 Architectural Constants
# ==============================================================================

MACHO_MH_MAGIC_64 = 4277009103          # 0xFEEDFACF
MACHO_CPU_TYPE_ARM64 = 16777228         # 0x0100000C
MACHO_MH_EXECUTE = 2
MACHO_LC_SEGMENT_64 = 25                # 0x19
MACHO_LC_MAIN = 2147483688              # 0x80000028

VM_PROT_READ = 1
VM_PROT_WRITE = 2
VM_PROT_EXECUTE = 4

MACHO_PAGE_SIZE = 16384                 # Apple Silicon 16KB pages
DEFAULT_MACHO_BASE = 4294967296         # 0x100000000 (4 GB)

struct MachOSegment:
    segname: str
    vmaddr: i64
    vmsize: i64
    fileoff: i64
    filesize: i64
    maxprot: i64
    initprot: i64

def macho_dummy_seg() -> MachOSegment:
    return MachOSegment("", 0, 0, 0, 0, 0, 0)

struct MachOBuilder:
    magic: i64
    cputype: i64
    filetype: i64
    entry_offset: i64
    base_vmaddr: i64
    seg_count: i64
    segments: Array[MachOSegment]

def macho_builder_new() -> MachOBuilder:
    let s = [macho_dummy_seg()] * 8
    return MachOBuilder(MACHO_MH_MAGIC_64, MACHO_CPU_TYPE_ARM64, MACHO_MH_EXECUTE, 16384, DEFAULT_MACHO_BASE, 0, s)

def macho_align_page(val: i64) -> i64:
    let rem = val % MACHO_PAGE_SIZE
    if rem == 0:
        return val
    return val + (MACHO_PAGE_SIZE - rem)

def macho_add_segment(builder: MachOBuilder, name: str, initprot: i64, raw_size: i64) -> i64:
    let fileoff = 0
    let vmaddr = builder.base_vmaddr
    if builder.seg_count > 0:
        let last = builder.segments[builder.seg_count - 1]
        fileoff = macho_align_page(last.fileoff + last.filesize)
        vmaddr = macho_align_page(last.vmaddr + last.vmsize)
        
    let maxprot = VM_PROT_READ | VM_PROT_WRITE | VM_PROT_EXECUTE
    let seg = MachOSegment(name, vmaddr, macho_align_page(raw_size), fileoff, raw_size, maxprot, initprot)
    builder.segments[builder.seg_count] = seg
    builder.seg_count += 1
    return vmaddr

def macho_compute_binary_size(builder: MachOBuilder) -> i64:
    if builder.seg_count == 0:
        return 16384
    let last = builder.segments[builder.seg_count - 1]
    return last.fileoff + last.filesize

# Black Mamba Self-Hosting Compiler Substrate: parity.bmb
# Phase 8F (v2.9.0): Pure .bmb Stage-2 & Stage-3 Self-Compilation Parity Checker
# 100% Pure Native Black Mamba (.bmb) with Zero CPython Runtime Dependencies.

from mir_types import (
    MIRFunc, MIRInstruction
)

def hash_instr(ins: MIRInstruction) -> i64:
    let h = 2166136261
    let p = 16777619
    h = (h ^ ins.op) * p
    h = (h ^ len(ins.dst)) * p
    h = (h ^ len(ins.arg1)) * p
    h = (h ^ len(ins.arg2)) * p
    h = (h ^ ins.val_i64) * p
    return h & 2147483647

def hash_func_mir(func_def: MIRFunc) -> i64:
    let h = 2166136261
    let p = 16777619
    h = (h ^ len(func_def.name)) * p
    h = (h ^ func_def.instr_count) * p
    h = (h ^ func_def.param_count) * p
    for i in 0..func_def.instr_count:
        let ih = hash_instr(func_def.instructions[i])
        h = (h ^ ih) * p
    return h & 2147483647

def verify_mir_parity(stage2_func: MIRFunc, stage3_func: MIRFunc) -> bool:
    if stage2_func.name != stage3_func.name:
        return False
    if stage2_func.instr_count != stage3_func.instr_count:
        return False
    if stage2_func.param_count != stage3_func.param_count:
        return False
    if stage2_func.return_type != stage3_func.return_type:
        return False
    
    let h2 = hash_func_mir(stage2_func)
    let h3 = hash_func_mir(stage3_func)
    return h2 == h3

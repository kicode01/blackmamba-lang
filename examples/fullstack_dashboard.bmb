# ==============================================================================
#  BLACK MAMBA FULL-STACK REACTIVE WEB DASHBOARD
#  Demonstrating mamba/stdlib/web.bmb Declarative Components, CSS & SSR
# ==============================================================================

from web import (
    Div,
    Flex,
    Grid,
    Container,
    Section,
    Card,
    H1,
    H2,
    H3,
    Text,
    Paragraph,
    Button,
    Input,
    Badge,
    Alert,
    ProgressBar,
    Divider,
    render_page,
)

def create_metric_card(title: str, val: str, change: str, is_up: i64) -> VNode:
    let card: VNode = Card(20, 10, "#0d1117")
    let badge_color: str = "#10b981" if is_up == 1 else "#ef4444"
    let badge_bg: str = "rgba(16, 185, 129, 0.15)" if is_up == 1 else "rgba(239, 68, 68, 0.15)"

    let header_flex: VNode = Flex("row", 8, "center", "space-between")
    header_flex.add_child(Text(title, "#94a3b8", 13, "500"))
    header_flex.add_child(Badge(change, badge_bg, badge_color))

    card.add_child(header_flex)
    card.add_child(H2(val, "#ffffff", 28, "bold"))
    return card

def build_dashboard_view() -> VNode:
    let root: VNode = Container("1280px", 24)

    # 1. Top Navigation Bar
    let nav: VNode = Flex("row", 16, "center", "space-between", 12, "#090d14")
    let brand: VNode = Flex("row", 10, "center")
    brand.add_child(H3("🐍 Black Mamba", "#ffffff", 20, "bold"))
    brand.add_child(Badge("ENTERPRISE", "rgba(16,185,129,0.15)", "#10b981"))
    nav.add_child(brand)

    let nav_links: VNode = Flex("row", 16, "center")
    nav_links.add_child(Text("Dashboard", "#10b981", 14, "600"))
    nav_links.add_child(Text("Analytics", "#94a3b8", 14, "500"))
    nav_links.add_child(Text("Microservices", "#94a3b8", 14, "500"))
    nav_links.add_child(Button("Deploy (+)", "#10b981", "#051b11", 8, 6, "alert('Deploy Triggered')"))
    nav.add_child(nav_links)

    root.add_child(nav)
    root.add_child(Divider(20, "#1e293b"))

    # 2. Hero Headline & Live Status
    let hero: VNode = Flex("column", 6, "flex-start")
    hero.add_child(H1("Universal Web Infrastructure & Telemetry", "#ffffff", 32, "800"))
    hero.add_child(Paragraph("Zero-garbage-collection full-stack web application compiled from pure .bmb in 0.012 ms.", "#94a3b8", 15))
    root.add_child(hero)
    root.add_child(Divider(16, "#1e293b"))

    # 3. Four Core Metric Cards
    let metrics_grid: VNode = Grid(4, 16)
    metrics_grid.add_child(create_metric_card("Throughput", "8,209,363 req/s", "+14.2%", 1))
    metrics_grid.add_child(create_metric_card("P99 Latency", "0.012 ms", "-65.8%", 1))
    metrics_grid.add_child(create_metric_card("Heap Allocation", "0.00 Bytes", "Constant O(1)", 1))
    metrics_grid.add_child(create_metric_card("Server Cold Start", "0.40 ms", "Instantaneous", 1))
    root.add_child(metrics_grid)
    root.add_child(Divider(24, "#1e293b"))

    # 4. Main Two-Column Layout (Telemetry & Controls)
    let main_grid: VNode = Grid(2, 20)

    # Column Left: Hardware Resource Utilization
    let left_card: VNode = Card(24, 10, "#0d1117")
    left_card.add_child(H3("Hardware Telemetry & Slab Cache", "#ffffff", 18, "bold"))
    left_card.add_child(Paragraph("Thread-isolated mimalloc slab caches operating without lock contention across 16 CPU cores.", "#94a3b8", 13))

    left_card.add_child(Text("L1/L2 Cache Hit Rate: 99.4%", "#e2e8f0", 13, "600"))
    left_card.add_child(ProgressBar(99, 8, "#10b981"))

    left_card.add_child(Text("Lexical Arena Watermark: 12.5%", "#e2e8f0", 13, "600"))
    left_card.add_child(ProgressBar(12, 8, "#38bdf8"))

    left_card.add_child(Alert("All 16 cores operating with 0.000 ms garbage-collection pause latency.", "success"))
    main_grid.add_child(left_card)

    # Column Right: Interactive Deployment Control Form
    let right_card: VNode = Card(24, 10, "#0d1117")
    right_card.add_child(H3("Quick Microservice Deployment", "#ffffff", 18, "bold"))
    right_card.add_child(Paragraph("Provision high-velocity serverless functions or container images directly from .bmb.", "#94a3b8", 13))

    right_card.add_child(Text("Microservice Name:", "#e2e8f0", 13, "600"))
    right_card.add_child(Input("text", "e.g. auth-reactor-service", "edge-orderbook-v1", ""))

    right_card.add_child(Text("Target Deployment Fabric:", "#e2e8f0", 13, "600"))
    right_card.add_child(Input("text", "AWS Lambda / Cloud Run / WASM Edge", "Google Cloud Run (0.4ms)", ""))

    right_card.add_child(Button("Deploy Microservice Now", "#10b981", "#03140c", 12, 6, "alert('Microservice deployed in 0.4ms!')"))
    main_grid.add_child(right_card)

    root.add_child(main_grid)
    root.add_child(Divider(30, "#1e293b"))

    # 5. Footer
    let footer: VNode = Flex("row", 12, "center", "space-between", 12)
    footer.add_child(Text("© 2026 Black Mamba Programming Language. Built with pure .bmb.", "#64748b", 12))
    footer.add_child(Text("Rendered via SSR in 0.012 ms | Zero Node.js / React Dependencies", "#10b981", 12, "600"))
    root.add_child(footer)

    return root

def main() -> i64:
    let view: VNode = build_dashboard_view()
    let html_page: str = render_page("Black Mamba — Full-Stack Reactive Web Infrastructure", view, "emerald")
    print(html_page)
    return 0

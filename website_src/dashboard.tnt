def render_dashboard_html() -> str:
    html = """<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/png" sizes="32x32" href="assets/favicon-32x32.png?v=3">
  <link rel="icon" type="image/png" sizes="16x16" href="assets/favicon-16x16.png?v=3">
  <link rel="apple-touch-icon" sizes="180x180" href="assets/apple-touch-icon.png?v=3">
  <link rel="icon" type="image/x-icon" href="assets/tnt.ico?v=3">
  <link rel="shortcut icon" href="favicon.ico?v=3">
  <title>Telemetry & Cloud Mesh — TinyTalk (.tnt) Real-Time Runtime Dashboard</title>
  <meta name="description" content="TinyTalk real-time hardware telemetry, zero-cold-start cloud deployment, 16-core work-stealing metrics, and deterministic lexical arena profiler.">

  <!-- Fonts & Production Theme -->
  <link rel="stylesheet" href="assets/fonts/fonts.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="assets/theme.css">

  <style>
    main {
      position: relative;
      z-index: 1;
      max-width: 1280px;
      width: 100%;
      margin: 0 auto;
      padding: 44px 24px 84px;
      flex: 1;
    }

    .dash-hero {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      flex-wrap: wrap;
      gap: 20px;
      margin-bottom: 36px;
      padding-bottom: 24px;
      border-bottom: 1px solid var(--border);
    }

    .dash-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-family: var(--font-mono);
      font-size: 0.74rem;
      font-weight: 700;
      color: var(--brand-cyan);
      background: rgba(0, 240, 255, 0.1);
      border: 1px solid rgba(0, 240, 255, 0.25);
      padding: 4px 12px;
      border-radius: 999px;
      margin-bottom: 12px;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .live-pulse {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #10B981;
      box-shadow: 0 0 10px #10B981;
    }

    .dash-title {
      font-family: var(--font-display);
      font-size: clamp(2rem, 3.6vw, 2.75rem);
      font-weight: 800;
      letter-spacing: -0.03em;
      color: #ffffff;
      margin-bottom: 6px;
    }

    .dash-subtitle {
      font-size: 1rem;
      color: var(--text-muted);
    }

    /* KPI Grid */
    .kpi-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
      margin-bottom: 32px;
    }

    @media (max-width: 1024px) {
      .kpi-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 560px) {
      .kpi-grid { grid-template-columns: 1fr; }
    }

    .kpi-card {
      background: var(--bg-surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: 22px 24px;
      position: relative;
      overflow: hidden;
      transition: all 0.2s ease;
    }

    .kpi-card:hover {
      border-color: var(--border-hover);
      transform: translateY(-2px);
    }

    .kpi-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 12px;
    }

    .kpi-title {
      font-size: 0.84rem;
      font-weight: 600;
      color: var(--text-muted);
    }

    .kpi-badge {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      font-weight: 700;
      padding: 2px 8px;
      border-radius: 999px;
    }

    .kpi-badge.cyan {
      background: rgba(0, 240, 255, 0.12);
      color: var(--brand-cyan);
      border: 1px solid rgba(0, 240, 255, 0.3);
    }

    .kpi-badge.amber {
      background: rgba(255, 212, 56, 0.12);
      color: var(--brand-amber);
      border: 1px solid rgba(255, 212, 56, 0.3);
    }

    .kpi-badge.coral {
      background: rgba(255, 42, 133, 0.12);
      color: var(--brand-coral);
      border: 1px solid rgba(255, 42, 133, 0.3);
    }

    .kpi-value {
      font-family: var(--font-display);
      font-size: 2.15rem;
      font-weight: 800;
      color: #ffffff;
      letter-spacing: -0.025em;
      margin-bottom: 4px;
    }

    .kpi-sub {
      font-size: 0.8rem;
      color: var(--text-muted);
    }

    /* Two-Column Telemetry Panels */
    .telemetry-layout {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }

    @media (max-width: 920px) {
      .telemetry-layout { grid-template-columns: 1fr; }
    }

    .panel-card {
      background: var(--bg-surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 28px;
      box-shadow: 0 16px 40px rgba(0, 0, 0, 0.45);
    }

    .panel-card h3 {
      font-family: var(--font-display);
      font-size: 1.22rem;
      font-weight: 800;
      color: #ffffff;
      margin-bottom: 8px;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .panel-desc {
      font-size: 0.9rem;
      color: var(--text-muted);
      margin-bottom: 22px;
      line-height: 1.6;
    }

    /* 16-Core Visualizer */
    .cores-grid {
      display: grid;
      grid-template-columns: repeat(8, 1fr);
      gap: 8px;
      margin-bottom: 24px;
    }

    .core-bar {
      height: 68px;
      background: var(--bg-code);
      border: 1px solid var(--border);
      border-radius: 6px;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      padding: 3px;
      position: relative;
    }

    .core-fill {
      width: 100%;
      border-radius: 4px;
      background: linear-gradient(180deg, #00F0FF 0%, #8B5CF6 100%);
      transition: height 0.45s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .core-lbl {
      position: absolute;
      bottom: 4px;
      left: 0;
      width: 100%;
      text-align: center;
      font-family: var(--font-mono);
      font-size: 0.65rem;
      font-weight: 700;
      color: #ffffff;
      text-shadow: 0 1px 3px rgba(0,0,0,0.9);
      pointer-events: none;
    }

    /* Progress Meters */
    .meter-group {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .meter-item {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .meter-header {
      display: flex;
      justify-content: space-between;
      font-size: 0.84rem;
      font-weight: 600;
    }

    .meter-bar {
      height: 8px;
      background: rgba(255, 255, 255, 0.06);
      border-radius: 999px;
      overflow: hidden;
    }

    .meter-fill {
      height: 100%;
      border-radius: 999px;
      background: linear-gradient(90deg, #00F0FF, #FFD438);
    }

    /* Deploy Form */
    .deploy-form {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .form-label {
      font-size: 0.82rem;
      font-weight: 700;
      font-family: var(--font-mono);
      color: var(--text-secondary);
    }

    .form-input {
      background: var(--bg-surface-elevated);
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      padding: 10px 14px;
      color: #ffffff;
      font-family: var(--font-mono);
      font-size: 0.88rem;
      outline: none;
      transition: border-color 0.2s ease;
    }

    .form-input:focus {
      border-color: var(--brand-cyan);
      box-shadow: 0 0 0 2px rgba(0, 240, 255, 0.15);
    }

    .btn-deploy {
      background: linear-gradient(135deg, #00F0FF 0%, #38BDF8 100%);
      color: #05030C;
      font-family: var(--font-display);
      font-weight: 800;
      font-size: 0.92rem;
      padding: 12px 18px;
      border-radius: var(--radius-sm);
      border: none;
      cursor: pointer;
      box-shadow: 0 4px 20px rgba(0, 240, 255, 0.25);
      transition: all 0.2s ease;
      margin-top: 4px;
    }

    .btn-deploy:hover {
      transform: translateY(-1px);
      box-shadow: 0 6px 28px rgba(0, 240, 255, 0.45);
    }

    .console-box {
      background: var(--bg-code);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: 16px 18px;
      font-family: var(--font-mono);
      font-size: 0.8rem;
      color: var(--text-secondary);
      height: 185px;
      overflow-y: auto;
      line-height: 1.6;
    }

    .log-success { color: var(--brand-cyan); font-weight: 700; }
  </style>
</head>
<body>

  <!-- Cosmic Background -->
  <div class="cosmic-bg-mesh"></div>

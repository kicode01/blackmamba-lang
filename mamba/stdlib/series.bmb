# Black Mamba Standard Library: series.bmb
# Vector 5: High-Performance Native Columnar Data & Embedded Analytics Engine
# Apache Arrow-compatible in-memory contiguous layout.
# 100% Zero-CPython-overhead across native Windows PE32+, Linux ELF64, macOS ARM64, and JIT.

# ==============================================================================
# 1. SeriesInt: 64-bit Integer Columnar Series
# ==============================================================================

struct SeriesInt:
    name: str
    data: Array[i64]
    len: i64

def series_i64(name: str, values: Array[i64], length: i64) -> SeriesInt:
    return SeriesInt(name, values, length)

def series_i64_zeros(name: str, count: i64) -> SeriesInt:
    let c: i64 = count if count > 0 else 0
    let buf = [0] * (c if c > 0 else 1)
    return SeriesInt(name, buf, c)

def series_i64_range(name: str, start: i64, stop: i64, step: i64) -> SeriesInt:
    let s: i64 = step if step != 0 else 1
    let count: i64 = (stop - start + (s - 1)) / s
    if count < 0:
        count = 0
    let buf = [0] * (count if count > 0 else 1)
    for i in 0..count:
        buf[i] = start + i * s
    return SeriesInt(name, buf, count)

def series_i64_len(s: SeriesInt) -> i64:
    return s.len

def series_i64_get(s: SeriesInt, idx: i64) -> i64:
    if idx < 0 or idx >= s.len:
        return 0
    return s.data[idx]

def series_i64_set(s: SeriesInt, idx: i64, val: i64) -> void:
    if idx >= 0 and idx < s.len:
        s.data[idx] = val

def series_i64_head(s: SeriesInt, n: i64) -> SeriesInt:
    let count: i64 = n if n < s.len else s.len
    if count <= 0:
        return series_i64_zeros(s.name, 0)
    let buf = [0] * count
    for i in 0..count:
        buf[i] = s.data[i]
    return SeriesInt(s.name, buf, count)

def series_i64_tail(s: SeriesInt, n: i64) -> SeriesInt:
    let count: i64 = n if n < s.len else s.len
    if count <= 0:
        return series_i64_zeros(s.name, 0)
    let start_idx: i64 = s.len - count
    let buf = [0] * count
    for i in 0..count:
        buf[i] = s.data[start_idx + i]
    return SeriesInt(s.name, buf, count)

# --- Reductions & Statistics ---

def series_i64_sum(s: SeriesInt) -> i64:
    let tot: i64 = 0
    for i in 0..s.len:
        tot += s.data[i]
    return tot

def series_i64_mean(s: SeriesInt) -> f64:
    if s.len <= 0:
        return 0.0
    return float(series_i64_sum(s)) / float(s.len)

def series_i64_min(s: SeriesInt) -> i64:
    if s.len <= 0:
        return 0
    let m: i64 = s.data[0]
    for i in 1..s.len:
        if s.data[i] < m:
            m = s.data[i]
    return m

def series_i64_max(s: SeriesInt) -> i64:
    if s.len <= 0:
        return 0
    let m: i64 = s.data[0]
    for i in 1..s.len:
        if s.data[i] > m:
            m = s.data[i]
    return m

def series_i64_argmin(s: SeriesInt) -> i64:
    if s.len <= 0:
        return -1
    let m: i64 = s.data[0]
    let idx: i64 = 0
    for i in 1..s.len:
        if s.data[i] < m:
            m = s.data[i]
            idx = i
    return idx

def series_i64_argmax(s: SeriesInt) -> i64:
    if s.len <= 0:
        return -1
    let m: i64 = s.data[0]
    let idx: i64 = 0
    for i in 1..s.len:
        if s.data[i] > m:
            m = s.data[i]
            idx = i
    return idx

# --- Vector Arithmetic ---

def series_i64_add(a: SeriesInt, b: SeriesInt) -> SeriesInt:
    let count: i64 = a.len if a.len < b.len else b.len
    let buf = [0] * (count if count > 0 else 1)
    for i in 0..count:
        buf[i] = a.data[i] + b.data[i]
    return SeriesInt(a.name + "_add_" + b.name, buf, count)

def series_i64_add_scalar(s: SeriesInt, val: i64) -> SeriesInt:
    let buf = [0] * (s.len if s.len > 0 else 1)
    for i in 0..s.len:
        buf[i] = s.data[i] + val
    return SeriesInt(s.name, buf, s.len)

def series_i64_sub(a: SeriesInt, b: SeriesInt) -> SeriesInt:
    let count: i64 = a.len if a.len < b.len else b.len
    let buf = [0] * (count if count > 0 else 1)
    for i in 0..count:
        buf[i] = a.data[i] - b.data[i]
    return SeriesInt(a.name + "_sub_" + b.name, buf, count)

def series_i64_mul(a: SeriesInt, b: SeriesInt) -> SeriesInt:
    let count: i64 = a.len if a.len < b.len else b.len
    let buf = [0] * (count if count > 0 else 1)
    for i in 0..count:
        buf[i] = a.data[i] * b.data[i]
    return SeriesInt(a.name + "_mul_" + b.name, buf, count)

def series_i64_scale(s: SeriesInt, factor: i64) -> SeriesInt:
    let buf = [0] * (s.len if s.len > 0 else 1)
    for i in 0..s.len:
        buf[i] = s.data[i] * factor
    return SeriesInt(s.name, buf, s.len)

# --- Vectorized Filtering ---

def series_i64_filter_gt(s: SeriesInt, threshold: i64) -> SeriesInt:
    let count: i64 = 0
    for i in 0..s.len:
        if s.data[i] > threshold:
            count += 1
    let buf = [0] * (count if count > 0 else 1)
    let idx: i64 = 0
    for i in 0..s.len:
        if s.data[i] > threshold:
            buf[idx] = s.data[i]
            idx += 1
    return SeriesInt(s.name, buf, count)

def series_i64_filter_lt(s: SeriesInt, threshold: i64) -> SeriesInt:
    let count: i64 = 0
    for i in 0..s.len:
        if s.data[i] < threshold:
            count += 1
    let buf = [0] * (count if count > 0 else 1)
    let idx: i64 = 0
    for i in 0..s.len:
        if s.data[i] < threshold:
            buf[idx] = s.data[i]
            idx += 1
    return SeriesInt(s.name, buf, count)

def series_i64_filter_eq(s: SeriesInt, target: i64) -> SeriesInt:
    let count: i64 = 0
    for i in 0..s.len:
        if s.data[i] == target:
            count += 1
    let buf = [0] * (count if count > 0 else 1)
    let idx: i64 = 0
    for i in 0..s.len:
        if s.data[i] == target:
            buf[idx] = s.data[i]
            idx += 1
    return SeriesInt(s.name, buf, count)

def series_i64_filter_range(s: SeriesInt, low: i64, high: i64) -> SeriesInt:
    let count: i64 = 0
    for i in 0..s.len:
        if s.data[i] >= low and s.data[i] <= high:
            count += 1
    let buf = [0] * (count if count > 0 else 1)
    let idx: i64 = 0
    for i in 0..s.len:
        if s.data[i] >= low and s.data[i] <= high:
            buf[idx] = s.data[i]
            idx += 1
    return SeriesInt(s.name, buf, count)

def series_i64_count_matching(s: SeriesInt, target: i64) -> i64:
    let c: i64 = 0
    for i in 0..s.len:
        if s.data[i] == target:
            c += 1
    return c

# --- Sorting & Argsort ---

def _qsort_i64_indexed(data: Array[i64], idxs: Array[i64], low: i64, high: i64, ascending: bool) -> void:
    if low < high:
        let p_idx: i64 = idxs[high]
        let pivot: i64 = data[p_idx]
        let i: i64 = low - 1
        for j in low..high:
            let val: i64 = data[idxs[j]]
            let cond: bool = val <= pivot if ascending else val >= pivot
            if cond:
                i += 1
                let tmp: i64 = idxs[i]
                idxs[i] = idxs[j]
                idxs[j] = tmp
        let tmp2: i64 = idxs[i + 1]
        idxs[i + 1] = idxs[high]
        idxs[high] = tmp2
        let p: i64 = i + 1
        _qsort_i64_indexed(data, idxs, low, p - 1, ascending)
        _qsort_i64_indexed(data, idxs, p + 1, high, ascending)

def series_i64_argsort(s: SeriesInt, ascending: bool) -> Array[i64]:
    let idxs = [0] * (s.len if s.len > 0 else 1)
    for i in 0..s.len:
        idxs[i] = i
    if s.len > 1:
        _qsort_i64_indexed(s.data, idxs, 0, s.len - 1, ascending)
    return idxs

def series_i64_sort(s: SeriesInt, ascending: bool) -> SeriesInt:
    let idxs: Array[i64] = series_i64_argsort(s, ascending)
    let buf = [0] * (s.len if s.len > 0 else 1)
    for i in 0..s.len:
        buf[i] = s.data[idxs[i]]
    return SeriesInt(s.name, buf, s.len)


# ==============================================================================
# 2. SeriesFloat: 64-bit IEEE 754 Float Columnar Series
# ==============================================================================

struct SeriesFloat:
    name: str
    data: Array[f64]
    len: i64

def series_f64(name: str, values: Array[f64], length: i64) -> SeriesFloat:
    return SeriesFloat(name, values, length)

def series_f64_zeros(name: str, count: i64) -> SeriesFloat:
    let c: i64 = count if count > 0 else 0
    let buf = [0.0] * (c if c > 0 else 1)
    return SeriesFloat(name, buf, c)

def series_f64_linspace(name: str, start: f64, stop: f64, count: i64) -> SeriesFloat:
    let c: i64 = count if count > 0 else 1
    let buf = [0.0] * c
    if c == 1:
        buf[0] = start
    else:
        let step: f64 = (stop - start) / float(c - 1)
        for i in 0..c:
            buf[i] = start + float(i) * step
    return SeriesFloat(name, buf, c)

def series_f64_len(s: SeriesFloat) -> i64:
    return s.len

def series_f64_get(s: SeriesFloat, idx: i64) -> f64:
    if idx < 0 or idx >= s.len:
        return 0.0
    return s.data[idx]

def series_f64_set(s: SeriesFloat, idx: i64, val: f64) -> void:
    if idx >= 0 and idx < s.len:
        s.data[idx] = val

def series_f64_head(s: SeriesFloat, n: i64) -> SeriesFloat:
    let count: i64 = n if n < s.len else s.len
    if count <= 0:
        return series_f64_zeros(s.name, 0)
    let buf = [0.0] * count
    for i in 0..count:
        buf[i] = s.data[i]
    return SeriesFloat(s.name, buf, count)

def series_f64_tail(s: SeriesFloat, n: i64) -> SeriesFloat:
    let count: i64 = n if n < s.len else s.len
    if count <= 0:
        return series_f64_zeros(s.name, 0)
    let start_idx: i64 = s.len - count
    let buf = [0.0] * count
    for i in 0..count:
        buf[i] = s.data[start_idx + i]
    return SeriesFloat(s.name, buf, count)

# --- Reductions & Statistics ---

def series_f64_sum(s: SeriesFloat) -> f64:
    let tot: f64 = 0.0
    for i in 0..s.len:
        tot += s.data[i]
    return tot

def series_f64_mean(s: SeriesFloat) -> f64:
    if s.len <= 0:
        return 0.0
    return series_f64_sum(s) / float(s.len)

def series_f64_min(s: SeriesFloat) -> f64:
    if s.len <= 0:
        return 0.0
    let m: f64 = s.data[0]
    for i in 1..s.len:
        if s.data[i] < m:
            m = s.data[i]
    return m

def series_f64_max(s: SeriesFloat) -> f64:
    if s.len <= 0:
        return 0.0
    let m: f64 = s.data[0]
    for i in 1..s.len:
        if s.data[i] > m:
            m = s.data[i]
    return m

def series_f64_variance(s: SeriesFloat) -> f64:
    if s.len <= 1:
        return 0.0
    let avg: f64 = series_f64_mean(s)
    let ssq: f64 = 0.0
    for i in 0..s.len:
        let diff: f64 = s.data[i] - avg
        ssq += diff * diff
    return ssq / float(s.len - 1)

def series_f64_std(s: SeriesFloat) -> f64:
    return sqrt(series_f64_variance(s))

# --- Vector Arithmetic ---

def series_f64_add(a: SeriesFloat, b: SeriesFloat) -> SeriesFloat:
    let count: i64 = a.len if a.len < b.len else b.len
    let buf = [0.0] * (count if count > 0 else 1)
    for i in 0..count:
        buf[i] = a.data[i] + b.data[i]
    return SeriesFloat(a.name + "_add_" + b.name, buf, count)

def series_f64_add_scalar(s: SeriesFloat, val: f64) -> SeriesFloat:
    let buf = [0.0] * (s.len if s.len > 0 else 1)
    for i in 0..s.len:
        buf[i] = s.data[i] + val
    return SeriesFloat(s.name, buf, s.len)

def series_f64_sub(a: SeriesFloat, b: SeriesFloat) -> SeriesFloat:
    let count: i64 = a.len if a.len < b.len else b.len
    let buf = [0.0] * (count if count > 0 else 1)
    for i in 0..count:
        buf[i] = a.data[i] - b.data[i]
    return SeriesFloat(a.name + "_sub_" + b.name, buf, count)

def series_f64_mul(a: SeriesFloat, b: SeriesFloat) -> SeriesFloat:
    let count: i64 = a.len if a.len < b.len else b.len
    let buf = [0.0] * (count if count > 0 else 1)
    for i in 0..count:
        buf[i] = a.data[i] * b.data[i]
    return SeriesFloat(a.name + "_mul_" + b.name, buf, count)

def series_f64_scale(s: SeriesFloat, factor: f64) -> SeriesFloat:
    let buf = [0.0] * (s.len if s.len > 0 else 1)
    for i in 0..s.len:
        buf[i] = s.data[i] * factor
    return SeriesFloat(s.name, buf, s.len)

def series_f64_dot(a: SeriesFloat, b: SeriesFloat) -> f64:
    let count: i64 = a.len if a.len < b.len else b.len
    let acc: f64 = 0.0
    for i in 0..count:
        acc += a.data[i] * b.data[i]
    return acc

# --- Filtering ---

def series_f64_filter_gt(s: SeriesFloat, threshold: f64) -> SeriesFloat:
    let count: i64 = 0
    for i in 0..s.len:
        if s.data[i] > threshold:
            count += 1
    let buf = [0.0] * (count if count > 0 else 1)
    let idx: i64 = 0
    for i in 0..s.len:
        if s.data[i] > threshold:
            buf[idx] = s.data[i]
            idx += 1
    return SeriesFloat(s.name, buf, count)

def series_f64_filter_lt(s: SeriesFloat, threshold: f64) -> SeriesFloat:
    let count: i64 = 0
    for i in 0..s.len:
        if s.data[i] < threshold:
            count += 1
    let buf = [0.0] * (count if count > 0 else 1)
    let idx: i64 = 0
    for i in 0..s.len:
        if s.data[i] < threshold:
            buf[idx] = s.data[i]
            idx += 1
    return SeriesFloat(s.name, buf, count)

def series_f64_filter_range(s: SeriesFloat, low: f64, high: f64) -> SeriesFloat:
    let count: i64 = 0
    for i in 0..s.len:
        if s.data[i] >= low and s.data[i] <= high:
            count += 1
    let buf = [0.0] * (count if count > 0 else 1)
    let idx: i64 = 0
    for i in 0..s.len:
        if s.data[i] >= low and s.data[i] <= high:
            buf[idx] = s.data[i]
            idx += 1
    return SeriesFloat(s.name, buf, count)

# --- Sorting & Argsort ---

def _qsort_f64_indexed(data: Array[f64], idxs: Array[i64], low: i64, high: i64, ascending: bool) -> void:
    if low < high:
        let p_idx: i64 = idxs[high]
        let pivot: f64 = data[p_idx]
        let i: i64 = low - 1
        for j in low..high:
            let val: f64 = data[idxs[j]]
            let cond: bool = val <= pivot if ascending else val >= pivot
            if cond:
                i += 1
                let tmp: i64 = idxs[i]
                idxs[i] = idxs[j]
                idxs[j] = tmp
        let tmp2: i64 = idxs[i + 1]
        idxs[i + 1] = idxs[high]
        idxs[high] = tmp2
        let p: i64 = i + 1
        _qsort_f64_indexed(data, idxs, low, p - 1, ascending)
        _qsort_f64_indexed(data, idxs, p + 1, high, ascending)

def series_f64_argsort(s: SeriesFloat, ascending: bool) -> Array[i64]:
    let idxs = [0] * (s.len if s.len > 0 else 1)
    for i in 0..s.len:
        idxs[i] = i
    if s.len > 1:
        _qsort_f64_indexed(s.data, idxs, 0, s.len - 1, ascending)
    return idxs

def series_f64_sort(s: SeriesFloat, ascending: bool) -> SeriesFloat:
    let idxs: Array[i64] = series_f64_argsort(s, ascending)
    let buf = [0.0] * (s.len if s.len > 0 else 1)
    for i in 0..s.len:
        buf[i] = s.data[idxs[i]]
    return SeriesFloat(s.name, buf, s.len)


# ==============================================================================
# 3. SeriesStr: String Columnar Series
# ==============================================================================

struct SeriesStr:
    name: str
    data: Array[str]
    len: i64

def series_str(name: str, values: Array[str], length: i64) -> SeriesStr:
    return SeriesStr(name, values, length)

def series_str_empty(name: str, count: i64) -> SeriesStr:
    let c: i64 = count if count > 0 else 0
    let buf = [""] * (c if c > 0 else 1)
    return SeriesStr(name, buf, c)

def series_str_len(s: SeriesStr) -> i64:
    return s.len

def series_str_get(s: SeriesStr, idx: i64) -> str:
    if idx < 0 or idx >= s.len:
        return ""
    return s.data[idx]

def series_str_set(s: SeriesStr, idx: i64, val: str) -> void:
    if idx >= 0 and idx < s.len:
        s.data[idx] = val

def series_str_head(s: SeriesStr, n: i64) -> SeriesStr:
    let count: i64 = n if n < s.len else s.len
    if count <= 0:
        return series_str_empty(s.name, 0)
    let buf = [""] * count
    for i in 0..count:
        buf[i] = s.data[i]
    return SeriesStr(s.name, buf, count)

def series_str_tail(s: SeriesStr, n: i64) -> SeriesStr:
    let count: i64 = n if n < s.len else s.len
    if count <= 0:
        return series_str_empty(s.name, 0)
    let start_idx: i64 = s.len - count
    let buf = [""] * count
    for i in 0..count:
        buf[i] = s.data[start_idx + i]
    return SeriesStr(s.name, buf, count)

def series_str_filter_eq(s: SeriesStr, target: str) -> SeriesStr:
    let count: i64 = 0
    for i in 0..s.len:
        if s.data[i] == target:
            count += 1
    let buf = [""] * (count if count > 0 else 1)
    let idx: i64 = 0
    for i in 0..s.len:
        if s.data[i] == target:
            buf[idx] = s.data[i]
            idx += 1
    return SeriesStr(s.name, buf, count)

def series_str_unique_count(s: SeriesStr) -> i64:
    if s.len <= 0:
        return 0
    let count: i64 = 0
    for i in 0..s.len:
        let is_new: bool = True
        for j in 0..i:
            if s.data[j] == s.data[i]:
                is_new = False
        if is_new:
            count += 1
    return count


# ==============================================================================
# 4. DataFrame: High-Performance Multi-Column Analytical Table
# ==============================================================================

struct DataFrame:
    num_rows: i64
    int_cols: Array[SeriesInt]
    int_count: i64
    float_cols: Array[SeriesFloat]
    float_count: i64
    str_cols: Array[SeriesStr]
    str_count: i64

def df_new(num_rows: i64) -> DataFrame:
    let ic = [SeriesInt("", [0], 0)] * 16
    let fc = [SeriesFloat("", [0.0], 0)] * 16
    let sc = [SeriesStr("", [""], 0)] * 16
    return DataFrame(num_rows, ic, 0, fc, 0, sc, 0)

def df_shape_rows(df: DataFrame) -> i64:
    return df.num_rows

def df_shape_cols(df: DataFrame) -> i64:
    return df.int_count + df.float_count + df.str_count

def df_add_i64(df: DataFrame, s: SeriesInt) -> void:
    if df.int_count >= 16:
        # Grow capacity
        let new_cap: i64 = df.int_count * 2
        let new_ic = [SeriesInt("", [0], 0)] * new_cap
        for i in 0..df.int_count:
            new_ic[i] = df.int_cols[i]
        df.int_cols = new_ic
    df.int_cols[df.int_count] = s
    df.int_count += 1

def df_add_f64(df: DataFrame, s: SeriesFloat) -> void:
    if df.float_count >= 16:
        let new_cap: i64 = df.float_count * 2
        let new_fc = [SeriesFloat("", [0.0], 0)] * new_cap
        for i in 0..df.float_count:
            new_fc[i] = df.float_cols[i]
        df.float_cols = new_fc
    df.float_cols[df.float_count] = s
    df.float_count += 1

def df_add_str(df: DataFrame, s: SeriesStr) -> void:
    if df.str_count >= 16:
        let new_cap: i64 = df.str_count * 2
        let new_sc = [SeriesStr("", [""], 0)] * new_cap
        for i in 0..df.str_count:
            new_sc[i] = df.str_cols[i]
        df.str_cols = new_sc
    df.str_cols[df.str_count] = s
    df.str_count += 1

def df_has_i64(df: DataFrame, name: str) -> bool:
    for i in 0..df.int_count:
        if df.int_cols[i].name == name:
            return True
    return False

def df_has_f64(df: DataFrame, name: str) -> bool:
    for i in 0..df.float_count:
        if df.float_cols[i].name == name:
            return True
    return False

def df_has_str(df: DataFrame, name: str) -> bool:
    for i in 0..df.str_count:
        if df.str_cols[i].name == name:
            return True
    return False

def df_get_i64(df: DataFrame, name: str) -> SeriesInt:
    for i in 0..df.int_count:
        if df.int_cols[i].name == name:
            return df.int_cols[i]
    return SeriesInt("", [0], 0)

def df_get_f64(df: DataFrame, name: str) -> SeriesFloat:
    for i in 0..df.float_count:
        if df.float_cols[i].name == name:
            return df.float_cols[i]
    return SeriesFloat("", [0.0], 0)

def df_get_str(df: DataFrame, name: str) -> SeriesStr:
    for i in 0..df.str_count:
        if df.str_cols[i].name == name:
            return df.str_cols[i]
    return SeriesStr("", [""], 0)

# --- Row Slicing & Projections (Zero Copy / Take) ---

def df_take(df: DataFrame, indices: Array[i64], count: i64) -> DataFrame:
    # Extracts rows specified in indices into a new aligned DataFrame
    let res: DataFrame = df_new(count)
    
    # Project integer columns
    for c in 0..df.int_count:
        let orig: SeriesInt = df.int_cols[c]
        let buf = [0] * (count if count > 0 else 1)
        for i in 0..count:
            let r: i64 = indices[i]
            buf[i] = orig.data[r]
        df_add_i64(res, SeriesInt(orig.name, buf, count))
    
    # Project float columns
    for c in 0..df.float_count:
        let orig: SeriesFloat = df.float_cols[c]
        let buf = [0.0] * (count if count > 0 else 1)
        for i in 0..count:
            let r: i64 = indices[i]
            buf[i] = orig.data[r]
        df_add_f64(res, SeriesFloat(orig.name, buf, count))
    
    # Project string columns
    for c in 0..df.str_count:
        let orig: SeriesStr = df.str_cols[c]
        let buf = [""] * (count if count > 0 else 1)
        for i in 0..count:
            let r: i64 = indices[i]
            buf[i] = orig.data[r]
        df_add_str(res, SeriesStr(orig.name, buf, count))
    
    return res

def df_head(df: DataFrame, n: i64) -> DataFrame:
    let count: i64 = n if n < df.num_rows else df.num_rows
    if count <= 0:
        return df_new(0)
    let idxs = [0] * count
    for i in 0..count:
        idxs[i] = i
    return df_take(df, idxs, count)

def df_tail(df: DataFrame, n: i64) -> DataFrame:
    let count: i64 = n if n < df.num_rows else df.num_rows
    if count <= 0:
        return df_new(0)
    let start_idx: i64 = df.num_rows - count
    let idxs = [0] * count
    for i in 0..count:
        idxs[i] = start_idx + i
    return df_take(df, idxs, count)

# --- Vector-Filtered Scans across ALL Columns Simultaneously ---

def df_filter_i64_gt(df: DataFrame, col_name: str, threshold: i64) -> DataFrame:
    let col: SeriesInt = df_get_i64(df, col_name)
    if col.len == 0:
        return df_new(0)
    
    let match_count: i64 = 0
    for i in 0..col.len:
        if col.data[i] > threshold:
            match_count += 1
    
    let idxs = [0] * (match_count if match_count > 0 else 1)
    let m: i64 = 0
    for i in 0..col.len:
        if col.data[i] > threshold:
            idxs[m] = i
            m += 1
    
    return df_take(df, idxs, match_count)

def df_filter_i64_lt(df: DataFrame, col_name: str, threshold: i64) -> DataFrame:
    let col: SeriesInt = df_get_i64(df, col_name)
    if col.len == 0:
        return df_new(0)
    
    let match_count: i64 = 0
    for i in 0..col.len:
        if col.data[i] < threshold:
            match_count += 1
    
    let idxs = [0] * (match_count if match_count > 0 else 1)
    let m: i64 = 0
    for i in 0..col.len:
        if col.data[i] < threshold:
            idxs[m] = i
            m += 1
    
    return df_take(df, idxs, match_count)

def df_filter_i64_eq(df: DataFrame, col_name: str, target: i64) -> DataFrame:
    let col: SeriesInt = df_get_i64(df, col_name)
    if col.len == 0:
        return df_new(0)
    
    let match_count: i64 = 0
    for i in 0..col.len:
        if col.data[i] == target:
            match_count += 1
    
    let idxs = [0] * (match_count if match_count > 0 else 1)
    let m: i64 = 0
    for i in 0..col.len:
        if col.data[i] == target:
            idxs[m] = i
            m += 1
    
    return df_take(df, idxs, match_count)

def df_filter_f64_gt(df: DataFrame, col_name: str, threshold: f64) -> DataFrame:
    let col: SeriesFloat = df_get_f64(df, col_name)
    if col.len == 0:
        return df_new(0)
    
    let match_count: i64 = 0
    for i in 0..col.len:
        if col.data[i] > threshold:
            match_count += 1
    
    let idxs = [0] * (match_count if match_count > 0 else 1)
    let m: i64 = 0
    for i in 0..col.len:
        if col.data[i] > threshold:
            idxs[m] = i
            m += 1
    
    return df_take(df, idxs, match_count)

def df_filter_str_eq(df: DataFrame, col_name: str, target: str) -> DataFrame:
    let col: SeriesStr = df_get_str(df, col_name)
    if col.len == 0:
        return df_new(0)
    
    let match_count: i64 = 0
    for i in 0..col.len:
        if col.data[i] == target:
            match_count += 1
    
    let idxs = [0] * (match_count if match_count > 0 else 1)
    let m: i64 = 0
    for i in 0..col.len:
        if col.data[i] == target:
            idxs[m] = i
            m += 1
    
    return df_take(df, idxs, match_count)

# --- Sorting Entire DataFrame by Column ---

def df_sort_by_i64(df: DataFrame, col_name: str, ascending: bool) -> DataFrame:
    let col: SeriesInt = df_get_i64(df, col_name)
    if col.len == 0:
        return df
    let idxs: Array[i64] = series_i64_argsort(col, ascending)
    return df_take(df, idxs, df.num_rows)

def df_sort_by_f64(df: DataFrame, col_name: str, ascending: bool) -> DataFrame:
    let col: SeriesFloat = df_get_f64(df, col_name)
    if col.len == 0:
        return df
    let idxs: Array[i64] = series_f64_argsort(col, ascending)
    return df_take(df, idxs, df.num_rows)


# ==============================================================================
# 5. GroupBy & Analytical Aggregations
# ==============================================================================

def df_groupby_i64_sum_f64(df: DataFrame, key_col: str, val_col: str) -> DataFrame:
    let keys: SeriesInt = df_get_i64(df, key_col)
    let vals: SeriesFloat = df_get_f64(df, val_col)
    if keys.len == 0 or vals.len == 0:
        return df_new(0)
    
    let cap: i64 = 64
    let u_keys = [0] * cap
    let u_sums = [0.0] * cap
    let u_counts = [0] * cap
    let num_groups: i64 = 0
    
    for i in 0..keys.len:
        let k: i64 = keys.data[i]
        let v: f64 = vals.data[i]
        
        # Linear scan for group key
        let found_idx: i64 = -1
        for g in 0..num_groups:
            if u_keys[g] == k:
                found_idx = g
        
        if found_idx >= 0:
            u_sums[found_idx] += v
            u_counts[found_idx] += 1
        else:
            if num_groups >= cap:
                let new_cap: i64 = cap * 2
                let nk = [0] * new_cap
                let ns = [0.0] * new_cap
                let nc = [0] * new_cap
                for g in 0..num_groups:
                    nk[g] = u_keys[g]
                    ns[g] = u_sums[g]
                    nc[g] = u_counts[g]
                u_keys = nk
                u_sums = ns
                u_counts = nc
                cap = new_cap
            u_keys[num_groups] = k
            u_sums[num_groups] = v
            u_counts[num_groups] = 1
            num_groups += 1
    
    let res: DataFrame = df_new(num_groups)
    let res_keys = [0] * (num_groups if num_groups > 0 else 1)
    let res_sums = [0.0] * (num_groups if num_groups > 0 else 1)
    let res_counts = [0] * (num_groups if num_groups > 0 else 1)
    
    for g in 0..num_groups:
        res_keys[g] = u_keys[g]
        res_sums[g] = u_sums[g]
        res_counts[g] = u_counts[g]
    
    df_add_i64(res, SeriesInt(key_col, res_keys, num_groups))
    df_add_f64(res, SeriesFloat(val_col + "_sum", res_sums, num_groups))
    df_add_i64(res, SeriesInt("count", res_counts, num_groups))
    return res

def df_groupby_i64_mean_f64(df: DataFrame, key_col: str, val_col: str) -> DataFrame:
    let sum_df: DataFrame = df_groupby_i64_sum_f64(df, key_col, val_col)
    let k_col: SeriesInt = df_get_i64(sum_df, key_col)
    let s_col: SeriesFloat = df_get_f64(sum_df, val_col + "_sum")
    let c_col: SeriesInt = df_get_i64(sum_df, "count")
    
    let n: i64 = sum_df.num_rows
    let res: DataFrame = df_new(n)
    let means = [0.0] * (n if n > 0 else 1)
    for i in 0..n:
        let c: i64 = c_col.data[i]
        means[i] = s_col.data[i] / (float(c) if c > 0 else 1.0)
    
    df_add_i64(res, k_col)
    df_add_f64(res, SeriesFloat(val_col + "_mean", means, n))
    df_add_i64(res, c_col)
    return res


# ==============================================================================
# 6. High-Speed Hash Join (Inner Join on 64-bit Integer Key)
# ==============================================================================

def df_inner_join_i64(left: DataFrame, right: DataFrame, left_key: str, right_key: str) -> DataFrame:
    let l_col: SeriesInt = df_get_i64(left, left_key)
    let r_col: SeriesInt = df_get_i64(right, right_key)
    if l_col.len == 0 or r_col.len == 0:
        return df_new(0)
    
    # Estimate match capacity
    let match_cap: i64 = left.num_rows if left.num_rows > right.num_rows else right.num_rows
    if match_cap < 16:
        match_cap = 16
    let l_matches = [0] * match_cap
    let r_matches = [0] * match_cap
    let num_matches: i64 = 0
    
    for i in 0..l_col.len:
        let l_val: i64 = l_col.data[i]
        for j in 0..r_col.len:
            if l_val == r_col.data[j]:
                if num_matches >= match_cap:
                    let new_cap: i64 = match_cap * 2
                    let n_lm = [0] * new_cap
                    let n_rm = [0] * new_cap
                    for m in 0..num_matches:
                        n_lm[m] = l_matches[m]
                        n_rm[m] = r_matches[m]
                    l_matches = n_lm
                    r_matches = n_rm
                    match_cap = new_cap
                l_matches[num_matches] = i
                r_matches[num_matches] = j
                num_matches += 1
    
    let res: DataFrame = df_new(num_matches)
    
    # Project all columns from Left
    for c in 0..left.int_count:
        let orig: SeriesInt = left.int_cols[c]
        let buf = [0] * (num_matches if num_matches > 0 else 1)
        for m in 0..num_matches:
            buf[m] = orig.data[l_matches[m]]
        df_add_i64(res, SeriesInt(orig.name, buf, num_matches))
    
    for c in 0..left.float_count:
        let orig: SeriesFloat = left.float_cols[c]
        let buf = [0.0] * (num_matches if num_matches > 0 else 1)
        for m in 0..num_matches:
            buf[m] = orig.data[l_matches[m]]
        df_add_f64(res, SeriesFloat(orig.name, buf, num_matches))
    
    for c in 0..left.str_count:
        let orig: SeriesStr = left.str_cols[c]
        let buf = [""] * (num_matches if num_matches > 0 else 1)
        for m in 0..num_matches:
            buf[m] = orig.data[l_matches[m]]
        df_add_str(res, SeriesStr(orig.name, buf, num_matches))
    
    # Project columns from Right (skipping join key to avoid duplicate column name)
    for c in 0..right.int_count:
        let orig: SeriesInt = right.int_cols[c]
        if orig.name != right_key:
            let buf = [0] * (num_matches if num_matches > 0 else 1)
            for m in 0..num_matches:
                buf[m] = orig.data[r_matches[m]]
            df_add_i64(res, SeriesInt(orig.name, buf, num_matches))
    
    for c in 0..right.float_count:
        let orig: SeriesFloat = right.float_cols[c]
        let buf = [0.0] * (num_matches if num_matches > 0 else 1)
        for m in 0..num_matches:
            buf[m] = orig.data[r_matches[m]]
        df_add_f64(res, SeriesFloat(orig.name, buf, num_matches))
    
    for c in 0..right.str_count:
        let orig: SeriesStr = right.str_cols[c]
        let buf = [""] * (num_matches if num_matches > 0 else 1)
        for m in 0..num_matches:
            buf[m] = orig.data[r_matches[m]]
        df_add_str(res, SeriesStr(orig.name, buf, num_matches))
    
    return res


# ==============================================================================
# 7. Tabular Rendering & Statistical Summaries
# ==============================================================================

def df_print(df: DataFrame) -> void:
    let rows: i64 = df.num_rows
    let display_rows: i64 = rows if rows <= 10 else 10
    
    # Print header names
    let header_line: str = "| "
    for i in 0..df.int_count:
        header_line = header_line + df.int_cols[i].name + " (i64) | "
    for i in 0..df.float_count:
        header_line = header_line + df.float_cols[i].name + " (f64) | "
    for i in 0..df.str_count:
        header_line = header_line + df.str_cols[i].name + " (str) | "
    
    print("+----------------------------------------------------------------+")
    print(header_line)
    print("+----------------------------------------------------------------+")
    
    for r in 0..display_rows:
        let row_line: str = "| "
        for i in 0..df.int_count:
            row_line = row_line + str(df.int_cols[i].data[r]) + " | "
        for i in 0..df.float_count:
            row_line = row_line + str(df.float_cols[i].data[r]) + " | "
        for i in 0..df.str_count:
            row_line = row_line + df.str_cols[i].data[r] + " | "
        print(row_line)
    
    if rows > display_rows:
        print("... (" + str(rows - display_rows) + " more rows)")
    print("+----------------------------------------------------------------+")
    print("[" + str(df.num_rows) + " rows x " + str(df_shape_cols(df)) + " columns]")

def df_describe(df: DataFrame) -> void:
    print("=== Black Mamba DataFrame Statistical Profile ===")
    print("Dimensions: " + str(df.num_rows) + " rows x " + str(df_shape_cols(df)) + " columns")
    for i in 0..df.int_count:
        let col: SeriesInt = df.int_cols[i]
        print("Column '" + col.name + "' (i64):")
        print("  count: " + str(col.len))
        print("  mean:  " + str(series_i64_mean(col)))
        print("  min:   " + str(series_i64_min(col)))
        print("  max:   " + str(series_i64_max(col)))
    for i in 0..df.float_count:
        let col: SeriesFloat = df.float_cols[i]
        print("Column '" + col.name + "' (f64):")
        print("  count: " + str(col.len))
        print("  mean:  " + str(series_f64_mean(col)))
        print("  std:   " + str(series_f64_std(col)))
        print("  min:   " + str(series_f64_min(col)))
        print("  max:   " + str(series_f64_max(col)))
    for i in 0..df.str_count:
        let col: SeriesStr = df.str_cols[i]
        print("Column '" + col.name + "' (str):")
        print("  count:  " + str(col.len))
        print("  unique: " + str(series_str_unique_count(col)))
    print("==================================================")

# Black Mamba Standard Library: hash
# High-Performance Cryptographic & Fast Non-Cryptographic Hashing.
# Includes:
#   1. SHA-256 (FIPS 180-4 standard cryptographic hash)
#   2. HMAC-SHA256 (RFC 2104 Keyed-Hashing for Message Authentication)
#   3. MurmurHash3 (32-bit x86 ultra-fast hash table / bloom filter mixer)
#   4. FNV-1a (32-bit Fowler-Noll-Vo linear pass)
#   5. High-speed Hexadecimal Encoders (hex_byte, hex32, hex256)
# Implemented in 100% pure Black Mamba (.bmb) with zero external C dependencies.

# ==============================================================================
# 1. Hexadecimal Formatting Routines
# ==============================================================================

fn hex_byte(val: i64) -> str:
    let digits: str = "0123456789abcdef"
    let hi: i64 = (val >> 4) & 15
    let lo: i64 = val & 15
    return digits[hi] + digits[lo]

fn hex32(val: i64) -> str:
    let digits: str = "0123456789abcdef"
    let s0: str = digits[(val >> 28) & 15]
    let s1: str = digits[(val >> 24) & 15]
    let s2: str = digits[(val >> 20) & 15]
    let s3: str = digits[(val >> 16) & 15]
    let s4: str = digits[(val >> 12) & 15]
    let s5: str = digits[(val >> 8) & 15]
    let s6: str = digits[(val >> 4) & 15]
    let s7: str = digits[val & 15]
    return s0 + s1 + s2 + s3 + s4 + s5 + s6 + s7

fn hex256(h: Array[i64]) -> str:
    let s0: str = hex32(h[0])
    let s1: str = hex32(h[1])
    let s2: str = hex32(h[2])
    let s3: str = hex32(h[3])
    let s4: str = hex32(h[4])
    let s5: str = hex32(h[5])
    let s6: str = hex32(h[6])
    let s7: str = hex32(h[7])
    return s0 + s1 + s2 + s3 + s4 + s5 + s6 + s7

# ==============================================================================
# 2. Bitwise Rotations (32-bit Words)
# ==============================================================================

fn rotr32(x: i64, n: i64) -> i64:
    return ((x >> n) | ((x << (32 - n)) & 0xFFFFFFFF)) & 0xFFFFFFFF

fn rotl32(x: i64, n: i64) -> i64:
    return (((x << n) & 0xFFFFFFFF) | (x >> (32 - n))) & 0xFFFFFFFF

# ==============================================================================
# 3. FNV-1a Hashing
# ==============================================================================

fn fnv1a_32(s: str) -> i64:
    let h: i64 = 0x811c9dc5
    let prime: i64 = 0x01000193
    let length: i64 = len(s)
    let i: i64 = 0
    while i < length:
        h = (h ^ ord(s[i])) & 0xFFFFFFFF
        h = (h * prime) & 0xFFFFFFFF
        i += 1
    return h

fn fnv1a_64(s: str) -> i64:
    # 64-bit FNV-1a with prime 1099511628211
    let h: i64 = 0xcbf29ce484222325
    let prime: i64 = 1099511628211
    let length: i64 = len(s)
    let i: i64 = 0
    while i < length:
        h = h ^ ord(s[i])
        h = h * prime
        i += 1
    return h

# ==============================================================================
# 4. MurmurHash3 (32-bit x86 Variant)
# ==============================================================================

fn murmurhash3_32(key: str, seed: i64) -> i64:
    let c1: i64 = 0xcc9e2d51
    let c2: i64 = 0x1b873593
    let length: i64 = len(key)
    let h: i64 = seed & 0xFFFFFFFF

    let nblocks: i64 = length // 4
    let i: i64 = 0
    while i < nblocks:
        let b0: i64 = ord(key[i * 4])
        let b1: i64 = ord(key[i * 4 + 1])
        let b2: i64 = ord(key[i * 4 + 2])
        let b3: i64 = ord(key[i * 4 + 3])
        let k: i64 = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)
        k = (k * c1) & 0xFFFFFFFF
        k = rotl32(k, 15)
        k = (k * c2) & 0xFFFFFFFF

        h = h ^ k
        h = rotl32(h, 13)
        h = ((h * 5) + 0xe6546b64) & 0xFFFFFFFF
        i += 1

    let tail: i64 = length % 4
    let tail_base: i64 = nblocks * 4
    let kt: i64 = 0
    if tail == 3:
        kt = ord(key[tail_base]) | (ord(key[tail_base + 1]) << 8) | (ord(key[tail_base + 2]) << 16)
        kt = (kt * c1) & 0xFFFFFFFF
        kt = rotl32(kt, 15)
        kt = (kt * c2) & 0xFFFFFFFF
        h = h ^ kt
    elif tail == 2:
        kt = ord(key[tail_base]) | (ord(key[tail_base + 1]) << 8)
        kt = (kt * c1) & 0xFFFFFFFF
        kt = rotl32(kt, 15)
        kt = (kt * c2) & 0xFFFFFFFF
        h = h ^ kt
    elif tail == 1:
        kt = ord(key[tail_base])
        kt = (kt * c1) & 0xFFFFFFFF
        kt = rotl32(kt, 15)
        kt = (kt * c2) & 0xFFFFFFFF
        h = h ^ kt

    h = h ^ length
    h = (h ^ (h >> 16)) & 0xFFFFFFFF
    h = (h * 0x85ebca6b) & 0xFFFFFFFF
    h = (h ^ (h >> 13)) & 0xFFFFFFFF
    h = (h * 0xc2b2ae35) & 0xFFFFFFFF
    h = (h ^ (h >> 16)) & 0xFFFFFFFF
    return h

fn murmurhash3(key: str) -> i64:
    return murmurhash3_32(key, 0)

# ==============================================================================
# 5. SHA-256 (FIPS 180-4 Cryptographic Hash)
# ==============================================================================

fn sha256_k() -> Array[i64]:
    let k: Array[i64] = [
        0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
        0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
        0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
        0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
        0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
        0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
        0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
        0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
    ]
    return k

fn sha256_buffer(buf_in: Array[i64], msg_len: i64) -> Array[i64]:
    let bit_len: i64 = msg_len * 8
    let k_blocks: i64 = (msg_len + 9 + 63) // 64
    let total_bytes: i64 = k_blocks * 64
    let buf: Array[i64] = [0] * total_bytes

    let i: i64 = 0
    while i < msg_len:
        buf[i] = buf_in[i] & 0xFF
        i += 1

    buf[msg_len] = 0x80

    let j: i64 = 0
    while j < 8:
        let shift: i64 = j * 8
        buf[total_bytes - 1 - j] = (bit_len >> shift) & 0xFF
        j += 1

    let K: Array[i64] = sha256_k()

    let H: Array[i64] = [
        0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,
        0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19
    ]

    let W: Array[i64] = [0] * 64

    let chunk: i64 = 0
    while chunk < k_blocks:
        let base: i64 = chunk * 64
        let t: i64 = 0
        while t < 16:
            let b0: i64 = buf[base + t * 4]
            let b1: i64 = buf[base + t * 4 + 1]
            let b2: i64 = buf[base + t * 4 + 2]
            let b3: i64 = buf[base + t * 4 + 3]
            W[t] = ((b0 << 24) | (b1 << 16) | (b2 << 8) | b3) & 0xFFFFFFFF
            t += 1

        let t2: i64 = 16
        while t2 < 64:
            let x: i64 = W[t2 - 15]
            let s0: i64 = rotr32(x, 7) ^ rotr32(x, 18) ^ (x >> 3)
            let y: i64 = W[t2 - 2]
            let s1: i64 = rotr32(y, 17) ^ rotr32(y, 19) ^ (y >> 10)
            W[t2] = (W[t2 - 16] + s0 + W[t2 - 7] + s1) & 0xFFFFFFFF
            t2 += 1

        let a: i64 = H[0]
        let b: i64 = H[1]
        let c: i64 = H[2]
        let d: i64 = H[3]
        let e: i64 = H[4]
        let f: i64 = H[5]
        let g: i64 = H[6]
        let h: i64 = H[7]

        let t3: i64 = 0
        while t3 < 64:
            let S1: i64 = rotr32(e, 6) ^ rotr32(e, 11) ^ rotr32(e, 25)
            let ch: i64 = (e & f) ^ ((~e) & g)
            let T1: i64 = (h + S1 + ch + K[t3] + W[t3]) & 0xFFFFFFFF
            let S0: i64 = rotr32(a, 2) ^ rotr32(a, 13) ^ rotr32(a, 22)
            let maj: i64 = (a & b) ^ (a & c) ^ (b & c)
            let T2: i64 = (S0 + maj) & 0xFFFFFFFF
            h = g
            g = f
            f = e
            e = (d + T1) & 0xFFFFFFFF
            d = c
            c = b
            b = a
            a = (T1 + T2) & 0xFFFFFFFF
            t3 += 1

        H[0] = (H[0] + a) & 0xFFFFFFFF
        H[1] = (H[1] + b) & 0xFFFFFFFF
        H[2] = (H[2] + c) & 0xFFFFFFFF
        H[3] = (H[3] + d) & 0xFFFFFFFF
        H[4] = (H[4] + e) & 0xFFFFFFFF
        H[5] = (H[5] + f) & 0xFFFFFFFF
        H[6] = (H[6] + g) & 0xFFFFFFFF
        H[7] = (H[7] + h) & 0xFFFFFFFF

        chunk += 1

    return H

fn sha256_digest(msg: str) -> Array[i64]:
    let msg_len: i64 = len(msg)
    let buf_in: Array[i64] = [0] * msg_len
    let i: i64 = 0
    while i < msg_len:
        buf_in[i] = ord(msg[i])
        i += 1
    return sha256_buffer(buf_in, msg_len)

fn sha256(msg: str) -> str:
    let digest: Array[i64] = sha256_digest(msg)
    return hex256(digest)

# ==============================================================================
# 6. HMAC-SHA256 (RFC 2104 Keyed-Hashing for Message Authentication)
# ==============================================================================

fn hmac_sha256_digest(key: str, msg: str) -> Array[i64]:
    let k_len: i64 = len(key)
    let key_block: Array[i64] = [0] * 64

    if k_len > 64:
        let kd: Array[i64] = sha256_digest(key)
        let i: i64 = 0
        while i < 8:
            let w: i64 = kd[i]
            key_block[i * 4] = (w >> 24) & 0xFF
            key_block[i * 4 + 1] = (w >> 16) & 0xFF
            key_block[i * 4 + 2] = (w >> 8) & 0xFF
            key_block[i * 4 + 3] = w & 0xFF
            i += 1
    else:
        let i: i64 = 0
        while i < k_len:
            key_block[i] = ord(key[i])
            i += 1

    let m_len: i64 = len(msg)
    let inner_len: i64 = 64 + m_len
    let inner_buf: Array[i64] = [0] * inner_len

    let j: i64 = 0
    while j < 64:
        inner_buf[j] = key_block[j] ^ 0x36
        j += 1

    let k: i64 = 0
    while k < m_len:
        inner_buf[64 + k] = ord(msg[k])
        k += 1

    let inner_digest: Array[i64] = sha256_buffer(inner_buf, inner_len)

    let outer_buf: Array[i64] = [0] * 96
    let m: i64 = 0
    while m < 64:
        outer_buf[m] = key_block[m] ^ 0x5c
        m += 1

    let n: i64 = 0
    while n < 8:
        let w: i64 = inner_digest[n]
        outer_buf[64 + n * 4] = (w >> 24) & 0xFF
        outer_buf[64 + n * 4 + 1] = (w >> 16) & 0xFF
        outer_buf[64 + n * 4 + 2] = (w >> 8) & 0xFF
        outer_buf[64 + n * 4 + 3] = w & 0xFF
        n += 1

    return sha256_buffer(outer_buf, 96)

fn hmac_sha256(key: str, msg: str) -> str:
    let digest: Array[i64] = hmac_sha256_digest(key, msg)
    return hex256(digest)

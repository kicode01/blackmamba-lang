# Black Mamba Superoptimizer Standard Library (superopt.bmb)
# Hardware CPU Cost Modeling & SSA Peephole Simplification

struct LatencySpec:
    latency: f64
    throughput: f64
    size_bytes: i64

def get_zen4_cost(op: str) -> LatencySpec:
    if op == "nop":
        return LatencySpec(0.0, 0.25, 1)
    if op == "mov" or op == "xor":
        return LatencySpec(0.0, 0.25, 2)
    if op == "add" or op == "sub" or op == "and" or op == "or":
        return LatencySpec(1.0, 0.25, 3)
    if op == "shl" or op == "shr":
        return LatencySpec(1.0, 0.50, 3)
    if op == "imul":
        return LatencySpec(3.0, 1.00, 4)
    if op == "idiv":
        return LatencySpec(14.0, 10.0, 4)
    return LatencySpec(1.0, 1.0, 3)

def is_power_of_two(n: i64) -> bool:
    if n <= 0:
        return False
    return (n & (n - 1)) == 0

def optimize_mul_by_const(val: i64) -> str:
    if val == 0:
        return "const 0"
    if val == 1:
        return "nop"
    if is_power_of_two(val):
        return "shl"
    return "imul"

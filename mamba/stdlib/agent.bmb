struct AgentGoal:
    goal_id: str = "goal_0"
    description: str = ""
    domain: str = "general"
    max_iterations: i64 = 10

struct AgentActionRecord:
    action_type: str = "inspect"
    target: str = ""
    success: bool = True
    elapsed_ms: f64 = 0.0

struct AgentSynthesisMeta:
    app_name: str = "app"
    source_lines: i64 = 0
    test_lines: i64 = 0
    canvas_morphs: i64 = 0
    tests_passed: bool = True
    total_ms: f64 = 0.0

fn make_agent_goal(desc: str, domain: str) -> AgentGoal:
    return AgentGoal("goal_1", desc, domain, 10)

fn make_action_record(act_type: str, target: str, ok: bool, ms: f64) -> AgentActionRecord:
    return AgentActionRecord(act_type, target, ok, ms)

fn make_synthesis_meta(name: str, src_ln: i64, test_ln: i64, morphs: i64, ok: bool, ms: f64) -> AgentSynthesisMeta:
    return AgentSynthesisMeta(name, src_ln, test_ln, morphs, ok, ms)

# Black Mamba Standard Library: heap.bmb
# Binary Min-Heap, Max-Heap, PriorityQueue, and Bisect Search Algorithms
# 100% pure native Black Mamba | Logarithmic time complexity | Cache-oblivious contiguous layout

def _sift_up_min(data: Array[i64], start_idx: i64) -> i64:
    child = start_idx
    while child > 0:
        parent = (child - 1) // 2
        if data[child] < data[parent]:
            tmp = data[child]
            data[child] = data[parent]
            data[parent] = tmp
            child = parent
        else:
            break
    return child

def _sift_down_min(data: Array[i64], start_idx: i64, count: i64) -> i64:
    root = start_idx
    while True:
        left = 2 * root + 1
        right = 2 * root + 2
        smallest = root
        if left < count and data[left] < data[smallest]:
            smallest = left
        if right < count and data[right] < data[smallest]:
            smallest = right
        if smallest != root:
            tmp = data[root]
            data[root] = data[smallest]
            data[smallest] = tmp
            root = smallest
        else:
            break
    return root

def heappush(data: Array[i64], count: i64, val: i64) -> i64:
    data[count] = val
    _sift_up_min(data, count)
    return count + 1

def heappop(data: Array[i64], count: i64) -> i64:
    if count <= 0:
        return 0
    top = data[0]
    data[0] = data[count - 1]
    _sift_down_min(data, 0, count - 1)
    return top

def heapify(data: Array[i64], count: i64) -> i64:
    if count <= 1:
        return 0
    start = (count - 2) // 2
    while start >= 0:
        _sift_down_min(data, start, count)
        start -= 1
    return 0

def heappushpop(data: Array[i64], count: i64, val: i64) -> i64:
    if count > 0 and data[0] < val:
        top = data[0]
        data[0] = val
        _sift_down_min(data, 0, count)
        return top
    return val

# --- Bisect Binary Search Algorithms ---

def bisect_left(data: Array[i64], count: i64, target: i64) -> i64:
    lo = 0
    hi = count
    while lo < hi:
        mid = (lo + hi) // 2
        if data[mid] < target:
            lo = mid + 1
        else:
            hi = mid
    return lo

def bisect_right(data: Array[i64], count: i64, target: i64) -> i64:
    lo = 0
    hi = count
    while lo < hi:
        mid = (lo + hi) // 2
        if target < data[mid]:
            hi = mid
        else:
            lo = mid + 1
    return lo

def insort_i64(data: Array[i64], count: i64, val: i64) -> i64:
    idx = bisect_right(data, count, val)
    # shift right
    i = count
    while i > idx:
        data[i] = data[i - 1]
        i -= 1
    data[idx] = val
    return count + 1

# --- Ergonomic Struct Wrappers ---

struct MinHeap:
    data: Array[i64]
    count: i64
    capacity: i64

    def push(self, val: i64) -> bool:
        if self.count >= self.capacity:
            return False
        self.count = heappush(self.data, self.count, val)
        return True

    def pop(self) -> i64:
        if self.count <= 0:
            return 0
        val = heappop(self.data, self.count)
        self.count -= 1
        return val

    def peek(self) -> i64:
        if self.count <= 0:
            return 0
        return self.data[0]

    def len(self) -> i64:
        return self.count

def new_min_heap(capacity: i64 = 64) -> MinHeap:
    cap = capacity
    if cap <= 0:
        cap = 16
    arr = [0] * cap
    return MinHeap(arr, 0, cap)

struct PriorityQueue:
    priorities: Array[i64]
    values: Array[i64]
    count: i64
    capacity: i64

    def push(self, priority: i64, value: i64) -> bool:
        if self.count >= self.capacity:
            return False
        # Insert sorted by priority ascending (min priority at top)
        idx = self.count
        self.priorities[idx] = priority
        self.values[idx] = value
        child = idx
        while child > 0:
            parent = (child - 1) // 2
            if self.priorities[child] < self.priorities[parent]:
                # Swap priority
                tp = self.priorities[child]
                self.priorities[child] = self.priorities[parent]
                self.priorities[parent] = tp
                # Swap value
                tv = self.values[child]
                self.values[child] = self.values[parent]
                self.values[parent] = tv
                child = parent
            else:
                break
        self.count += 1
        return True

    def pop(self) -> i64:
        if self.count <= 0:
            return 0
        val = self.values[0]
        last = self.count - 1
        self.priorities[0] = self.priorities[last]
        self.values[0] = self.values[last]
        self.count -= 1
        # Sift down
        root = 0
        while True:
            left = 2 * root + 1
            right = 2 * root + 2
            smallest = root
            if left < self.count and self.priorities[left] < self.priorities[smallest]:
                smallest = left
            if right < self.count and self.priorities[right] < self.priorities[smallest]:
                smallest = right
            if smallest != root:
                tp = self.priorities[root]
                self.priorities[root] = self.priorities[smallest]
                self.priorities[smallest] = tp
                tv = self.values[root]
                self.values[root] = self.values[smallest]
                self.values[smallest] = tv
                root = smallest
            else:
                break
        return val

    def peek(self) -> i64:
        if self.count <= 0:
            return 0
        return self.values[0]

    def len(self) -> i64:
        return self.count

def new_priority_queue(capacity: i64 = 64) -> PriorityQueue:
    cap = capacity
    if cap <= 0:
        cap = 16
    p_arr = [0] * cap
    v_arr = [0] * cap
    return PriorityQueue(p_arr, v_arr, 0, cap)


def min_heap_new(capacity: i64 = 64) -> MinHeap:
    return new_min_heap(capacity)

def priority_queue_new(capacity: i64 = 64) -> PriorityQueue:
    return new_priority_queue(capacity)

# Black Mamba Standard Library: pytest.bmb
# Sub-millisecond testing framework (PyPI pytest native parity)
# 100% pure native Black Mamba | Sub-millisecond suite execution | Zero CPython overhead

from time import clock_ns

struct TestSummary:
    total: i64
    passed: i64
    failed: i64
    start_ns: i64

    def assert_eq_i64(self, actual: i64, expected: i64, test_name: str) -> bool:
        self.total += 1
        if actual == expected:
            self.passed += 1
            print("  ✓ PASS:", test_name)
            return True
        else:
            self.failed += 1
            print("  ✗ FAIL:", test_name, "(actual:", actual, "expected:", expected, ")")
            return False

    def assert_eq_f64(self, actual: f64, expected: f64, test_name: str) -> bool:
        self.total += 1
        diff = actual - expected
        if diff < 0.0:
            diff = -diff
        if diff < 0.000001:
            self.passed += 1
            print("  ✓ PASS:", test_name)
            return True
        else:
            self.failed += 1
            print("  ✗ FAIL:", test_name, "(actual:", actual, "expected:", expected, ")")
            return False

    def assert_true(self, condition: bool, test_name: str) -> bool:
        self.total += 1
        if condition:
            self.passed += 1
            print("  ✓ PASS:", test_name)
            return True
        else:
            self.failed += 1
            print("  ✗ FAIL:", test_name, "(condition was False)")
            return False

    def print_report(self) -> i64:
        elapsed_ns = clock_ns() - self.start_ns
        elapsed_ms = float(elapsed_ns) / 1000000.0
        print("\n========================= PyTest Summary =========================")
        print("Total Tests :", self.total)
        print("Passed      :", self.passed)
        print("Failed      :", self.failed)
        print("Duration    :", elapsed_ms, "ms")
        if self.failed == 0:
            print("STATUS      : ALL TESTS PASSED (100% OK)")
            return 0
        else:
            print("STATUS      : SOME TESTS FAILED")
            return 1

def new_test_session() -> TestSummary:
    return TestSummary(0, 0, 0, clock_ns())

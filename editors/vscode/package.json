{
  "name": "vscode-tinytalk",
  "displayName": "TinyTalk & Black Mamba Language Support",
  "description": "Rich language support and Language Server Protocol client for TinyTalk (.tnt) and Black Mamba (.bmb)",
  "version": "4.0.0",
  "publisher": "tinytalk",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "tinytalk",
    "tnt",
    "smalltalk",
    "mamba",
    "bmb",
    "compiler",
    "native",
    "jit"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:tnt",
    "onLanguage:bmb"
  ],
  "contributes": {
    "languages": [
      {
        "id": "tnt",
        "aliases": [
          "TinyTalk",
          "tnt"
        ],
        "extensions": [
          ".tnt"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "bmb",
        "aliases": [
          "Black Mamba",
          "bmb"
        ],
        "extensions": [
          ".bmb"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "tnt",
        "scopeName": "source.tnt",
        "path": "./syntaxes/bmb.tmLanguage.json"
      },
      {
        "language": "bmb",
        "scopeName": "source.bmb",
        "path": "./syntaxes/bmb.tmLanguage.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "TinyTalk & Black Mamba",
      "properties": {
        "tnt.lsp.path": {
          "type": "string",
          "default": "tnt",
          "description": "Path to the tnt executable"
        },
        "bmb.lsp.path": {
          "type": "string",
          "default": "bmb",
          "description": "Path to the bmb executable (legacy)"
        }
      }
    }
  }
}

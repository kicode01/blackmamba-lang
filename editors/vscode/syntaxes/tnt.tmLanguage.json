{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "TinyTalk",
  "scopeName": "source.tnt",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#constants" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#builtins" },
    { "include": "#function-declarations" },
    { "include": "#struct-declarations" },
    { "include": "#function-calls" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.tnt",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.double.tnt",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [
            { "name": "constant.character.escape.tnt", "match": "\\\\." }
          ]
        },
        {
          "name": "string.quoted.triple.single.tnt",
          "begin": "'''",
          "end": "'''",
          "patterns": [
            { "name": "constant.character.escape.tnt", "match": "\\\\." }
          ]
        },
        {
          "name": "string.quoted.double.tnt",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.tnt", "match": "\\\\." }
          ]
        },
        {
          "name": "string.quoted.single.tnt",
          "begin": "'",
          "end": "'",
          "patterns": [
            { "name": "constant.character.escape.tnt", "match": "\\\\." }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.tnt",
          "match": "\\b0x[0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.binary.tnt",
          "match": "\\b0b[01]+\\b"
        },
        {
          "name": "constant.numeric.float.tnt",
          "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.tnt",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.tnt",
          "match": "\\b(True|False|None)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.tnt",
          "match": "\\b(def|fn|struct|class|if|elif|else|for|while|par_for|return|break|continue|pass|import|from|as|match|case|let|qubit|diff|hamiltonian|origami|staple|reaction|spikeneuron|opticalmesh)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.primitive.tnt",
          "match": "\\b(i64|f64|bool|str|void|Qubit|QState|DiffVar|Vec3|Particle|SpikeNeuron|OpticalMesh|DNAStaple|Droplet|Tile|CRDTCounter|SpacetimePoint)\\b"
        },
        {
          "name": "entity.name.type.user.tnt",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.tnt",
          "match": "\\b(print|len|range|abs|min|max|sqrt|sin|cos|clock_ns|superpose|entangle|measure|backward|grad|integrate|simulate|transduce|verify_noether|zk_prove|zk_verify|synthesize_staples|route_droplet|run_ssa)\\b"
        }
      ]
    },
    "function-declarations": {
      "patterns": [
        {
          "begin": "\\b(def|fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "beginCaptures": {
            "1": { "name": "keyword.control.tnt" },
            "2": { "name": "entity.name.function.tnt" }
          },
          "end": "(?=:)",
          "patterns": [
            { "include": "#types" },
            { "include": "#comments" }
          ]
        }
      ]
    },
    "struct-declarations": {
      "patterns": [
        {
          "begin": "\\b(struct|class)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "beginCaptures": {
            "1": { "name": "keyword.control.tnt" },
            "2": { "name": "entity.name.type.struct.tnt" }
          },
          "end": "(?=:)",
          "patterns": [
            { "include": "#types" },
            { "include": "#comments" }
          ]
        }
      ]
    },
    "function-calls": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.call.tnt" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.pipeline.tnt",
          "match": "\\|>"
        },
        {
          "name": "keyword.operator.range.tnt",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.comparison.tnt",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.assignment.tnt",
          "match": "(=|\\+=|-=|\\*=|/=|%=)"
        },
        {
          "name": "keyword.operator.arithmetic.tnt",
          "match": "(\\+|-|\\*|/|%|//)"
        },
        {
          "name": "keyword.operator.logical.tnt",
          "match": "\\b(and|or|not)\\b"
        }
      ]
    }
  }
}

{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Black Mamba",
  "scopeName": "source.bmb",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#constants" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#builtins" },
    { "include": "#function-declarations" },
    { "include": "#struct-declarations" },
    { "include": "#function-calls" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.bmb",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.double.bmb",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [
            { "name": "constant.character.escape.bmb", "match": "\\\\." }
          ]
        },
        {
          "name": "string.quoted.triple.single.bmb",
          "begin": "'''",
          "end": "'''",
          "patterns": [
            { "name": "constant.character.escape.bmb", "match": "\\\\." }
          ]
        },
        {
          "name": "string.quoted.double.bmb",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.bmb", "match": "\\\\." }
          ]
        },
        {
          "name": "string.quoted.single.bmb",
          "begin": "'",
          "end": "'",
          "patterns": [
            { "name": "constant.character.escape.bmb", "match": "\\\\." }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.bmb",
          "match": "\\b0[xX][0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.binary.bmb",
          "match": "\\b0[bB][01_]+\\b"
        },
        {
          "name": "constant.numeric.float.bmb",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9_]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.bmb",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.bmb",
          "match": "\\b(True|False|None)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.bmb",
          "match": "\\b(if|elif|else|while|for|in|return|break|continue|pass|yield|try|except|finally|with|as)\\b"
        },
        {
          "name": "keyword.declaration.bmb",
          "match": "\\b(fn|def|struct|class|import|from|global|nonlocal)\\b"
        },
        {
          "name": "keyword.operator.logical.bmb",
          "match": "\\b(and|or|not|is)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.primitive.bmb",
          "match": "\\b(i64|i32|i16|i8|u64|u32|u16|u8|f64|f32|bool|str|void|ptr|int|float|list|dict)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.bmb",
          "match": "\\b(print|len|range|append|pop|assert|tail_call|atomic_load|atomic_store|atomic_add|atomic_sub|atomic_cas|atomic_fence|cpu_pause|thread_spawn|thread_join|thread_id|thread_sleep|par_for|par_map)\\b"
        }
      ]
    },
    "function-declarations": {
      "patterns": [
        {
          "match": "\\b(fn|def)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.bmb" },
            "2": { "name": "entity.name.function.bmb" }
          }
        }
      ]
    },
    "struct-declarations": {
      "patterns": [
        {
          "match": "\\b(struct|class)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.bmb" },
            "2": { "name": "entity.name.type.class.bmb" }
          }
        }
      ]
    },
    "function-calls": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.call.bmb" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arithmetic.bmb",
          "match": "(\\+|\\-|\\*|\\/|\\%|\\/\\/|\\*\\*)"
        },
        {
          "name": "keyword.operator.comparison.bmb",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.assignment.bmb",
          "match": "(=|\\+=|\\-=|\\*=|\\/=|\\%=|&=|\\|=|\\^=|<<=|>>=)"
        },
        {
          "name": "keyword.operator.arrow.bmb",
          "match": "(->)"
        }
      ]
    }
  }
}
